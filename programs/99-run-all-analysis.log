 24.         capture scalar __b = _b[tau`h']
 25.         if (_rc == 0) {
 26.             local tau_sum = `tau_sum' + __b
 27.             local tau_n   = `tau_n' + 1
 28.         }
 29.     }
 30.     local att_post = cond(`tau_n' > 0, `tau_sum'/`tau_n', .)
 31.     local treat_p = .
