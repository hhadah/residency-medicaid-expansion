. foreach grp in volume notvolume {
  2. 
.     * Sample = this group's expansion states + ALL never-expansion controls.
.     preserve
  3.     if "`grp'" == "volume"    keep if treated_state == 0 | (treated_state 
> == 1 & gme_vol == 1)
  4.     if "`grp'" == "notvolume" keep if treated_state == 0 | (treated_state 
> == 1 & gme_notvol == 1)
