> de `_rc'."
 26.         continue
 27.     }
 28.     local coef = _b[tau0]
 29.     local se   = _se[tau0]
 30.     local tstat = `coef' / `se'
 31.     local pvalue = 2*ttail(e(df_r), abs(`tstat'))
 32.     local tau_sum = 0
 33.     local tau_n = 0
 34.     forval h = 0/5 {
 35.         capture scalar __tmp = _b[tau`h']
 36.         if (_rc == 0) {
 37.             local tau_sum = `tau_sum' + __tmp
 38.             local tau_n = `tau_n' + 1
 39.         }
 40.     }
 41.     if (`tau_n' > 0) local avg_treat = `tau_sum' / `tau_n'
 42.     else local avg_treat = .
 43.     local pretrend_p = .
 44.     local treat_p = .
 45.     capture noisily test pre1 pre2 pre3 pre4 pre5
 46.     if (_rc == 0) {
 47.         local pretrend_p = r(p)
 48.     }
 49.     capture noisily test tau0 tau1 tau2 tau3 tau4 tau5
 50.     if (_rc == 0) {
 51.         local treat_p = r(p)
 52.     }
 53.     * Calculate baseline mean (pre-treatment observations in treated state
> s)
.     quietly summarize `outcome' if treated_state == 1 & year < year_expanded 
> [aw=total_population_10]
 54.     local baseline_mean = r(mean)
 55.     if missing(`baseline_mean') | `baseline_mean' == 0 {
 56.         local baseline_mean = 1
 57.     }
 58.     local pct_effect = (`avg_treat' / `baseline_mean') * 100
 59.     if `pct_effect' < -100 {
 60.         local pct_effect = -100
 61.     }
 62.     local n_programs = .
 63.     local n_states = .
 64.     capture levelsof program_numeric_id if !missing(`outcome'), local(acti
> ve_programs)
 65.     if (_rc == 0) {
 66.         local n_programs : word count `active_programs'
 67.     }
 68.     capture levelsof state_id if !missing(`outcome'), local(active_states)
 69.     if (_rc == 0) {
 70.         local n_states : word count `active_states'
 71.     }
 72. 
.     * National impact for annotation. Use the raw count aggregate computed
