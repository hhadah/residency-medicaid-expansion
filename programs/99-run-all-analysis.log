.     post `mech' ("`grp'") (`att_post') (`treat_p') (`baseline') (`pct') (`n_t
> p')
 40.     di as result "Group `grp': avg post ATT = " %6.3f `att_post' ///
>         "  (" %4.1f `pct' "% of baseline " %5.3f `baseline' "); joint p = " %
> 5.3f `treat_p'
 41. 
.     * ---- Event-study plot (same scheme as 05/12) --------------------------
.     matrix plot_coef = J(11, 3, .)
 42.     matrix colnames plot_coef = period coef se
 43.     local row = 1
 44.     forval h = 5(-1)1 {
 45.         matrix plot_coef[`row',1] = -`h'
 46.         capture matrix plot_coef[`row',2] = _b[pre`h']
 47.         capture matrix plot_coef[`row',3] = _se[pre`h']
 48.         local ++row
 49.     }
 50.     forval h = 0/5 {
 51.         matrix plot_coef[`row',1] = `h'
 52.         capture matrix plot_coef[`row',2] = _b[tau`h']
 53.         capture matrix plot_coef[`row',3] = _se[tau`h']
 54.         local ++row
 55.     }
 56.     drop _all
 57.     svmat plot_coef, names(col)
 58.     keep if !missing(period)
 59.     gen ci_upper = coef + 1.96*se
 60.     gen ci_lower = coef - 1.96*se
 61.     gen byte pre_period  = (period < 0)
 62.     gen byte post_period = (period >= 0)
 63. 
.     local glab = cond("`grp'"=="volume", "Volume-Responsive GME States", "Non
> -Responsive GME States (Fixed/None)")
 64.     local fname = cond("`grp'"=="volume", "VolumeResponsive", "NonResponsi
> ve")
 65.     local prefix : display %02.0f `plotnum'
 66.     local post_line ""
 67.     if (`att_post' < .) local post_line "(scatteri `att_post' 0 `att_post'
>  5, recast(line) lpattern(dash) lcolor(red) lwidth(medium))"
 68. 
.     twoway ///
>         (rarea ci_upper ci_lower period if pre_period,  fcolor(dkgreen%45) lc
> olor(dkgreen%45) lwidth(none)) ///
>         (rarea ci_upper ci_lower period if post_period, fcolor(maroon%45)  lc
> olor(maroon%45)  lwidth(none)) ///
>         (line coef period if pre_period,  lcolor(dkgreen) lwidth(medium)) ///
>         (line coef period if post_period, lcolor(maroon)  lwidth(medium)) ///
>         (scatter coef period if pre_period,  mcolor(dkgreen) msymbol(circle) 
