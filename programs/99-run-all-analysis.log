> medium) lpattern(solid)) ///
>            (line urb_coef urb_period if urb_post, lcolor("31 119 180") lwidth
> (medium) lpattern(solid)) ///
>            (line rur_coef rur_period if rur_pre, lcolor("255 127 14") lwidth(
