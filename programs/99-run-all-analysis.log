. * -------------------------------------------------------------------------
. * Pre-compute aggregate annual change in residency positions from the
. * raw count regressions (matched, quota). The per-100k figure annotations
. * reuse these so the "Avg. annual change" number matches the raw count
. * version (otherwise the per-100k specification implicitly reweights and
. * yields a different aggregate).
. * -------------------------------------------------------------------------
. global agg_matched ""

. global agg_quota ""

. foreach raw_outcome in matched quota {
  2.     capture confirm variable `raw_outcome'
  3.     if (_rc != 0) continue
  4. 
.     quietly count if treated_state == 1 & !missing(`raw_outcome')
  5.     if (r(N) == 0) continue
  6.     quietly count if treated_state == 0 & !missing(`raw_outcome')
  7.     if (r(N) == 0) continue
  8. 
.     di "Pre-computing aggregate effect for `raw_outcome'..."
  9.     capture noisily did_imputation `raw_outcome' program_numeric_id year y
> ear_expanded ///
>         [aw=total_population_10], horizons(0/5) pretrend(5) ///
>         fe(program_numeric_id year) cluster(state_id) minn(0)
 10.     if (_rc != 0) continue
 11. 
.     local _sum = 0
 12.     local _n = 0
 13.     forval h = 0/5 {
 14.         capture local _coef = _b[tau`h']
 15.         if (_rc == 0) {
 16.             local _sum = `_sum' + `_coef'
 17.             local _n = `_n' + 1
 18.         }
 19.     }
 20.     if (`_n' > 0) {
 21.         local _avg = `_sum' / `_n'
 22.         quietly levelsof program_numeric_id if treated_state == 1 & !missi
> ng(`raw_outcome'), local(_tprogs)
 23.         local _ntreated : word count `_tprogs'
 24.         global agg_`raw_outcome' = `_avg' * `_ntreated'
 25.         di as result "  Aggregate annual change in `raw_outcome' positions
> : " %15.0fc ${agg_`raw_outcome'}
 26.     }
 27. }
