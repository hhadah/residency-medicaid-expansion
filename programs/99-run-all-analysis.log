. di ""


. di "=========================================================================
> "
=========================================================================

. di "HETEROGENEITY ANALYSIS: By Urban/Rural Classification"
HETEROGENEITY ANALYSIS: By Urban/Rural Classification

. di "Urban vs Rural"
Urban vs Rural

. di "=========================================================================
> "
=========================================================================

. di ""


. 
. local plotnum = 8

. 
. foreach outcome of global outcomes {
  2.     
.     capture confirm variable `outcome'
  3.     if _rc != 0 {
  4.         di as error "Outcome `outcome' not found. Skipping."
  5.         continue
  6.     }
  7.     
.     quietly count if urban_rural == 0 & treated_state == 1 & !missing(`outcom
> e')
  8.     if (r(N) == 0) {
  9.         di as error "Outcome `outcome': no treated urban observations."
 10.         continue
 11.     }
 12.     
.     quietly count if urban_rural == 1 & treated_state == 1 & !missing(`outcom
> e')
 13.     if (r(N) == 0) {
 14.         di as error "Outcome `outcome': no treated rural observations."
 15.         continue
 16.     }
 17.     
.     di ""
 18.     di "==================================================================
> ======="
 19.     di "HETEROGENEITY ANALYSIS: ${label_`outcome'}"
 20.     di "Outcome variable: `outcome'"
 21.     di "==================================================================
> ======="
 22.     di ""
 23.     
.     * Run did_imputation with heterogeneous effects by urban/rural (0 = urban
> , 1 = rural)
.     capture noisily did_imputation `outcome' program_numeric_id year year_exp
> anded [aw=total_population_10], ///
>         horizons(0/5) pretrend(5) ///
>         cluster(state_id) ///
>         hetby(urban_rural) ///
>         fe(program_numeric_id year) ///
>         minn(0) autosample
 24.     
.     if (_rc != 0) {
 25.         di as error "did_imputation failed for outcome `outcome'. Error co
> de `_rc'."
 26.         continue
 27.     }
 28.     
.     * =====================
.     * Post-treatment averages and p-value tests
.     * =====================
.     * Test pretrend assumption
.     test pre1 pre2 pre3 pre4 pre5
 29.     local pretrend_p = r(p)
 30. 
.     * Calculate average effects for both groups
.     local avg_urban = (_b[tau0_0] + _b[tau1_0] + _b[tau2_0] + _b[tau3_0] + _b
> [tau4_0] + _b[tau5_0])/6
 31.     local avg_rural = (_b[tau0_1] + _b[tau1_1] + _b[tau2_1] + _b[tau3_1] +
>  _b[tau4_1] + _b[tau5_1])/6
 32.     local avg_diff = `avg_rural' - `avg_urban'
 33. 
.     * Test difference in post averages and get p-value
.     testnl ((_b[tau0_1] + _b[tau1_1] + _b[tau2_1] + _b[tau3_1] + _b[tau4_1] +
>  _b[tau5_1])/6) - ((_b[tau0_0] + _b[tau1_0] + _b[tau2_0] + _b[tau3_0] + _b[ta
> u4_0] + _b[tau5_0])/6) = 0
 34.     local avg_diff_p = r(p)
 35. 
.     * Joint test of heterogeneity across all periods
.     test (tau0_0 = tau0_1) (tau1_0 = tau1_1) (tau2_0 = tau2_1) (tau3_0 = tau3
> _1) (tau4_0 = tau4_1) (tau5_0 = tau5_1)
 36.     local joint_het_p = r(p)
 37. 
.     * Test individual group significance (joint test for post-treatment effec
> ts)
.     test tau0_0 tau1_0 tau2_0 tau3_0 tau4_0 tau5_0
 38.     local urban_p = r(p)
 39.     test tau0_1 tau1_1 tau2_1 tau3_1 tau4_1 tau5_1
 40.     local rural_p = r(p)
 41. 
.     * Calculate baseline means (pre-treatment observations in estimation samp
> le)
.     quietly summarize `outcome' if urban_rural == 0 & year < year_expanded & 
> e(sample) [aw=total_population_10]
 42.     local baseline_urban = r(mean)
 43.     if missing(`baseline_urban') | `baseline_urban' == 0 {
 44.         local baseline_urban = 1
 45.     }
 46.     
.     quietly summarize `outcome' if urban_rural == 1 & year < year_expanded & 
> e(sample) [aw=total_population_10]
 47.     local baseline_rural = r(mean)
 48.     if missing(`baseline_rural') | `baseline_rural' == 0 {
 49.         local baseline_rural = 1
 50.     }
 51.     
.     local pct_urban = (`avg_urban' / `baseline_urban') * 100
 52.     local pct_rural = (`avg_rural' / `baseline_rural') * 100
 53.     if `pct_urban' < -100 local pct_urban = -100
 54.     if `pct_rural' < -100 local pct_rural = -100
 55. 
.     * Compute national/total annual impact for each group.
.     * matched (raw): avg * N treated programs in subset.
.     * per_100k:      avg * sum(state_pop across treated programs in subset) /
>  100k.
.     local urban_national = .
 56.     local rural_national = .
 57.     local has_national = 0
 58.     if "`outcome'" == "matched" {
 59.         quietly levelsof program_numeric_id if treated_state == 1 & urban_
> rural == 0 & !missing(`outcome'), local(_uprogs)
 60.         local n_uprogs : word count `_uprogs'
 61.         quietly levelsof program_numeric_id if treated_state == 1 & urban_
> rural == 1 & !missing(`outcome'), local(_rprogs)
 62.         local n_rprogs : word count `_rprogs'
 63.         local urban_national = `avg_urban' * `n_uprogs'
 64.         local rural_national = `avg_rural' * `n_rprogs'
 65.         local has_national = 1
 66.     }
 67.     else if strpos("`outcome'", "_per_100k") > 0 {
 68.         preserve
 69.         keep if treated_state == 1 & urban_rural == 0 & !missing(`outcome'
> )
 70.         collapse (mean) total_population_10, by(program_numeric_id)
 71.         quietly summarize total_population_10
 72.         local sum_urban_pop = r(sum)
 73.         restore
 74.         preserve
 75.         keep if treated_state == 1 & urban_rural == 1 & !missing(`outcome'
> )
 76.         collapse (mean) total_population_10, by(program_numeric_id)
 77.         quietly summarize total_population_10
 78.         local sum_rural_pop = r(sum)
 79.         restore
 80.         local urban_national = `avg_urban' * `sum_urban_pop' / 100000
 81.         local rural_national = `avg_rural' * `sum_rural_pop' / 100000
 82.         local has_national = 1
 83.     }
 84.     local urban_national_text = cond(`has_national', string(`urban_nationa
> l', "%9.0fc"), "NA")
 85.     local rural_national_text = cond(`has_national', string(`rural_nationa
> l', "%9.0fc"), "NA")
 86. 
.     * Store values in locals for annotation
.     local text_urban = string(`avg_urban', "%9.2f")
 87.     local text_rural = string(`avg_rural', "%9.2f")
 88.     local text_urban_p = string(`urban_p', "%9.2f")
 89.     local text_rural_p = string(`rural_p', "%9.2f")
 90.     local text_het = string(`joint_het_p', "%9.2f")
 91.     local text_avg_diff = string(`avg_diff', "%9.2f")
 92.     local text_avg_diff_p = string(`avg_diff_p', "%9.2f")
 93.     local text_baseline_urban = string(`baseline_urban', "%9.2f")
 94.     local text_baseline_rural = string(`baseline_rural', "%9.2f")
 95.     local text_pct_urban = string(`pct_urban', "%9.1f")
 96.     local text_pct_rural = string(`pct_rural', "%9.1f")
 97.     
.     di "Average urban effect: " %9.3f `avg_urban' " (p = " %9.3f `urban_p' ")
> "
 98.     di "Average rural effect: " %9.3f `avg_rural' " (p = " %9.3f `rural_p'
>  ")"
 99.     di "Difference (rural - urban): " %9.3f `avg_diff' " (p = " %9.3f `avg
> _diff_p' ")"
100.     di "Joint heterogeneity test p-value: " %9.3f `joint_het_p'
101.     di "Pretrend joint p-value: " %9.3f `pretrend_p'
102.     if (`has_national') {
103.         di "Avg. annual aggregate effect (urban): " %15.0fc `urban_nationa
> l'
104.         di "Avg. annual aggregate effect (rural): " %15.0fc `rural_nationa
> l'
105.     }
106. 
.     * =====================
.     * Plotting with annotation
.     * =====================
.     * Create matrices for both groups (0 = urban, 1 = rural)
.     matrix urban = J(11, 5, .)  // 5 pretrends + 6 treatment periods
107.     matrix rural = J(11, 5, .)
108.     matrix colnames urban = period coef se ci_upper ci_lower
109.     matrix colnames rural = period coef se ci_upper ci_lower
110.     
.     local row = 1
111.     
.     * Pretrend coefficients (same for both groups)
.     forval h = 5(-1)1 {
112.         * Urban counties
.         matrix urban[`row',1] = -`h'
113.         matrix urban[`row',2] = _b[pre`h']
114.         matrix urban[`row',3] = _se[pre`h']
115.         matrix urban[`row',4] = _b[pre`h'] + 1.96*_se[pre`h']
116.         matrix urban[`row',5] = _b[pre`h'] - 1.96*_se[pre`h']
117.         
.         * Rural counties (same pretrends)
.         matrix rural[`row',1] = -`h'
118.         matrix rural[`row',2] = _b[pre`h']
119.         matrix rural[`row',3] = _se[pre`h']  
120.         matrix rural[`row',4] = _b[pre`h'] + 1.96*_se[pre`h']
121.         matrix rural[`row',5] = _b[pre`h'] - 1.96*_se[pre`h']
122.         
.         local ++row
123.     }
124.     
.     * Treatment coefficients - separate by group
.     forval h = 0/5 {
125.         * Urban (tau_0)
.         matrix urban[`row',1] = `h'
126.         matrix urban[`row',2] = _b[tau`h'_0]
127.         matrix urban[`row',3] = _se[tau`h'_0]
128.         matrix urban[`row',4] = _b[tau`h'_0] + 1.96*_se[tau`h'_0]
129.         matrix urban[`row',5] = _b[tau`h'_0] - 1.96*_se[tau`h'_0]
130.         
.         * Rural (tau_1)
.         matrix rural[`row',1] = `h'
131.         matrix rural[`row',2] = _b[tau`h'_1]
132.         matrix rural[`row',3] = _se[tau`h'_1]
133.         matrix rural[`row',4] = _b[tau`h'_1] + 1.96*_se[tau`h'_1]
134.         matrix rural[`row',5] = _b[tau`h'_1] - 1.96*_se[tau`h'_1]
135.         
.         local ++row
136.     }
137.     
.     * Convert matrices to variables for plotting
.     preserve
138.     clear
139.     svmat urban, names(urb)
140.     svmat rural, names(rur)
141.     
.     * Rename variables
.     rename urb1 urb_period
142.     rename urb2 urb_coef  
143.     rename urb3 urb_se
144.     rename urb4 urb_ci_upper
145.     rename urb5 urb_ci_lower
146.     
.     rename rur1 rur_period
147.     rename rur2 rur_coef
148.     rename rur3 rur_se  
149.     rename rur4 rur_ci_upper
150.     rename rur5 rur_ci_lower
151.     
.     * Create pre/post indicators for plotting
.     gen urb_pre = (urb_period < 0)
152.     gen urb_post = (urb_period >= 0)
153.     gen rur_pre = (rur_period < 0)  
154.     gen rur_post = (rur_period >= 0)
155. 
.     * Calculate dynamic annotation coordinates using maximum upper confidence
>  intervals from both groups
.     quietly summarize urb_ci_upper
156.     local max1 = r(max)
157.     quietly summarize rur_ci_upper
158.     local max2 = r(max) 
159.     local y_annot = max(`max1', `max2') * 0.9
160.     local x_annot = -2
161.     
.     local short = "${short_`outcome'}"
162.     local label = "${label_`outcome'}"
163.     if ("`label'" == "") {
164.         local label = "`outcome'"
165.     }
166.     local prefix : display %02.0f `plotnum'
167.     local ytitle_str "Treatment Effect (difference-in-differences)"
168.     local plot_title "Heterogeneity: Urban vs Rural - `label'"
169. 
.     * Adjust for per 100k outcomes
.     if (strpos("`short'", "_100k") > 0) {
170.         local ytitle_str "Treatment Effect (per 100,000 population)"
171.         local x_annot = -2
172.     }
173.     if ("`outcome'" == "matched") {
174.         local ytitle_str "Treatment Effect (number of residency positions)
> "
175.     }
176. 
.     * Build text annotations.
.     * Main annotation (left): urban/rural averages and difference.
.     * Extra annotation at x = 3, same y-level: national/total impact split by
>  urban/rural
.     * (residency positions for raw matched; additional doctors nationally for
>  per-100k).
.     local main_text `"text(`y_annot' `x_annot' `"Urban Avg: `text_urban' (p=`
> text_urban_p')"' `"Rural Avg: `text_rural' (p=`text_rural_p')"' `"Difference:
>  `text_avg_diff' (p=`text_avg_diff_p')"', size(large))"'
177.     local extra_text ""
178.     if ("`outcome'" == "matched") {
179.         local extra_text `"text(`y_annot' 3 `"Avg. annual change in"' `"re
> sidency positions:"' `"Urban: `urban_national_text'"' `"Rural: `rural_nationa
> l_text'"', size(medium))"'
180.     }
181.     else if (strpos("`short'", "_100k") > 0) {
182.         local extra_text `"text(`y_annot' 3 `"Avg. annual change in"' `"do
> ctors nationally:"' `"Urban: `urban_national_text'"' `"Rural: `rural_national
> _text'"', size(medium))"'
183.     }
184. 
.     * Create combined plot using twoway, with annotation
.     twoway (rarea urb_ci_upper urb_ci_lower urb_period if urb_pre, fcolor("31
>  119 180%20") lcolor("31 119 180%20") lwidth(none)) ///
>            (rarea urb_ci_upper urb_ci_lower urb_period if urb_post, fcolor("3
> 1 119 180%20") lcolor("31 119 180%20") lwidth(none)) ///
