. local plotnum = 22

. foreach outcome of global outcomes {
  2.     capture confirm variable `outcome'
  3.     if _rc != 0 {
  4.         di as error "Outcome `outcome' not found. Skipping."
  5.         continue
  6.     }
  7.     quietly count if treated_state == 1 & !missing(`outcome')
  8.     if (r(N) == 0) {
  9.         di as error "Outcome `outcome': no treated observations with data.
> "
 10.         continue
 11.     }
 12.     quietly count if treated_state == 0 & !missing(`outcome')
 13.     if (r(N) == 0) {
 14.         di as error "Outcome `outcome': no control observations with data.
> "
 15.         continue
 16.     }
 17.     di ""
 18.     di "==================================================================
> ======="
 19.     di "DID ANALYSIS (unweighted, pop control): ${label_`outcome'}"
 20.     di "Outcome variable: `outcome'"
 21.     di "==================================================================
> ======="
 22.     di ""
 23.     capture noisily did_imputation `outcome' program_numeric_id year year_
> expanded, ///
>         horizons(0/5) pretrend(5) fe(program_numeric_id year) ///
>         controls(total_population_10) cluster(state_id) minn(0)
 24.     if (_rc != 0) {
 25.         di as error "did_imputation failed for outcome `outcome'. Error co
> de `_rc'."
 26.         continue
 27.     }
 28.     local coef = _b[tau0]
 29.     local se   = _se[tau0]
 30.     local tstat = `coef' / `se'
 31.     local pvalue = 2*ttail(e(df_r), abs(`tstat'))
 32.     local tau_sum = 0
 33.     local tau_n = 0
 34.     forval h = 0/5 {
 35.         capture scalar __tmp = _b[tau`h']
 36.         if (_rc == 0) {
 37.             local tau_sum = `tau_sum' + __tmp
 38.             local tau_n = `tau_n' + 1
 39.         }
 40.     }
 41.     if (`tau_n' > 0) local avg_treat = `tau_sum' / `tau_n'
 42.     else local avg_treat = .
 43.     local pretrend_p = .
 44.     local treat_p = .
 45.     capture noisily test pre1 pre2 pre3 pre4 pre5
 46.     if (_rc == 0) {
 47.         local pretrend_p = r(p)
 48.     }
 49.     capture noisily test tau0 tau1 tau2 tau3 tau4 tau5
 50.     if (_rc == 0) {
 51.         local treat_p = r(p)
 52.     }
 53.     * Calculate baseline mean (pre-treatment observations in treated state
> s, unweighted)
.     quietly summarize `outcome' if treated_state == 1 & year < year_expanded
 54.     local baseline_mean = r(mean)
 55.     if missing(`baseline_mean') | `baseline_mean' == 0 {
 56.         local baseline_mean = 1
 57.     }
 58.     local pct_effect = (`avg_treat' / `baseline_mean') * 100
 59.     if `pct_effect' < -100 {
 60.         local pct_effect = -100
 61.     }
 62.     local n_programs = .
 63.     local n_states = .
 64.     capture levelsof program_numeric_id if !missing(`outcome'), local(acti
> ve_programs)
 65.     if (_rc == 0) {
 66.         local n_programs : word count `active_programs'
 67.     }
 68.     capture levelsof state_id if !missing(`outcome'), local(active_states)
 69.     if (_rc == 0) {
 70.         local n_states : word count `active_states'
 71.     }
 72. 
.     * National impact for annotation. Use the raw count aggregate computed
.     * pre-loop so per-100k and raw-count figures show the same number.
.     local national_effect = .
 73.     local has_national = 0
 74.     local national_label "residency positions"
 75.     if "`outcome'" == "matched" | "`outcome'" == "matched_per_100k" {
 76.         if "${agg_matched}" != "" {
 77.             local national_effect = ${agg_matched}
 78.             local has_national = 1
 79.         }
 80.     }
 81.     else if "`outcome'" == "quota_per_100k" {
 82.         if "${agg_quota}" != "" {
 83.             local national_effect = ${agg_quota}
 84.             local has_national = 1
 85.             local national_label "quota positions"
 86.         }
 87.     }
 88.     local national_text = cond(`has_national', string(`national_effect', "
> %9.0fc"), "NA")
 89. 
.     post `did_results' ("`outcome'") ///
>         (`coef') (`se') (`tstat') (`pvalue') (`avg_treat') ///
>         (`pretrend_p') (`treat_p') (`n_programs') (`n_states')
 90.     di "ATT (tau0): " %9.3f `coef' "  SE: " %9.3f `se' "  p = " %9.3f `pva
> lue'
 91.     di "Average post-treatment effect: " %9.3f `avg_treat'
 92.     if (`has_national') di "Avg. annual aggregate effect: " %15.0fc `natio
> nal_effect'
 93.     if (`pretrend_p' < .) di "Pretrend joint p-value: " %9.3f `pretrend_p'
 94.     if (`treat_p' < .)   di "Treatment joint p-value: " %9.3f `treat_p'
 95.     matrix plot_coef = J(11, 3, .)
 96.     matrix colnames plot_coef = period coef se
 97.     local row = 1
 98.     forval h = 5(-1)1 {
 99.         matrix plot_coef[`row',1] = -`h'
100.         capture matrix plot_coef[`row',2] = _b[pre`h']
101.         capture matrix plot_coef[`row',3] = _se[pre`h']
102.         local ++row
103.     }
104.     forval h = 0/5 {
105.         matrix plot_coef[`row',1] = `h'
106.         capture matrix plot_coef[`row',2] = _b[tau`h']
107.         capture matrix plot_coef[`row',3] = _se[tau`h']
108.         local ++row
109.     }
110.     preserve
111.     clear
112.     svmat plot_coef, names(col)
113.     keep if !missing(period)
114.     gen ci_upper = coef + 1.96*se
115.     gen ci_lower = coef - 1.96*se
116.     gen byte pre_period = (period < 0)
117.     gen byte post_period = (period >= 0)
118.     local avg_text = cond(`avg_treat' < ., string(`avg_treat', "%9.2f"), "
> NA")
119.     local treat_text = cond(`treat_p' < ., string(`treat_p', "%9.2f"), "NA
> ")
120.     local baseline_text = string(`baseline_mean', "%9.2f")
121.     local pct_text = string(`pct_effect', "%9.1f")
122.     local post_line ""
123.     if (`avg_treat' < .) {
124.         local post_line "(scatteri `avg_treat' 0 `avg_treat' 5, recast(lin
> e) lpattern(dash) lcolor(red) lwidth(medium))"
125.     }
126.     local short = "${short_`outcome'}"
127.     local label = "${label_`outcome'}"
128.     if ("`label'" == "") {
129.         local label = "`outcome'"
130.     }
131.     local prefix : display %02.0f `plotnum'
132.     local ytitle_str "Treatment Effect (difference-in-differences)"
133.     local plot_title "Event Study: `label'"
134.     quietly summarize ci_upper
135.     local y_annot = r(max) * 0.9
136.     local x_annot = -3
137.     if (strpos("`short'", "_100k") > 0) {
138.         local ytitle_str "Treatment Effect (per 100,000 population)"
139.         local x_annot = -3
140.     }
141.     if ("`outcome'" == "matched") {
142.         local ytitle_str "Treatment Effect (number of residency positions)
> "
143.     }
144.     local main_text `"text(`y_annot' `x_annot' `"Baseline Mean: `baseline_
> text'"' `"Post avg = `avg_text' (`pct_text'%)"' `"p-value = `treat_text'"', s
> ize(large))"'
145.     local extra_text ""
146.     if (`has_national') {
147.         local extra_text `"text(`y_annot' 3 `"Avg. annual change in"' `"`n
> ational_label':"' `"`national_text'"', size(large))"'
148.     }
149.     twoway ///
>         (rarea ci_upper ci_lower period if pre_period, fcolor(dkgreen%45) lco
> lor(dkgreen%45) lwidth(none)) ///
>         (rarea ci_upper ci_lower period if post_period, fcolor(maroon%45) lco
> lor(maroon%45) lwidth(none)) ///
>         (line coef period if pre_period, lcolor(dkgreen) lwidth(medium)) ///
>         (line coef period if post_period, lcolor(maroon) lwidth(medium)) ///
>         (scatter coef period if pre_period, mcolor(dkgreen) msymbol(circle) m
> size(medlarge)) ///
>         (scatter coef period if post_period, mcolor(maroon) msymbol(circle) m
> size(medlarge)) ///
>         `post_line' ///
>         , ///
>         xline(-0.5, lcolor(black) lpattern(solid) lwidth(thin)) ///
>         yline(0, lcolor(black) lpattern(solid) lwidth(thin)) ///
>         xlabel(-5(1)5, labsize(small)) ///
>         ylabel(#8, labsize(small) format(%9.2f)) ///
>         xtitle("Years relative to Medicaid expansion", size(small)) ///
>         ytitle("`ytitle_str'", size(small)) ///
>         `main_text' ///
>         `extra_text' ///
>         legend(off) ///
>         graphregion(color(white)) plotregion(color(white))
150.     graph export "${figdir}/`prefix'-did_`short'_popcnt_event.png", as(png
