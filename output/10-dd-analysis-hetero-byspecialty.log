 99.             matrix rural[`row',4] = _b[tau`h'_1] + 1.96*_se[tau`h'_1]
100.             matrix rural[`row',5] = _b[tau`h'_1] - 1.96*_se[tau`h'_1]
101.             
.             local ++row
102.         }
103.         
.         preserve
