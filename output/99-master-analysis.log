133.         matrix rural[`row',4] = _b[tau`h'_1] + 1.96
> *_se[tau`h'_1]
134.         matrix rural[`row',5] = _b[tau`h'_1] - 1.96
> *_se[tau`h'_1]
135.         
.         local ++row
