. local plotnum = 11

. 
. * Loop over each specialty group
. levelsof specialty_group, local(spec_groups)
1 2

. foreach spec of local spec_groups {
  2.     * Get the specialty group name for this group
.     levelsof specialty_group_name if specialty_group =
> = `spec', local(spec_name) clean
  3.     
.     di ""
  4.     di "===========================================
> =============================="
  5.     di "SPECIALTY GROUP: `spec_name'"
  6.     di "===========================================
> =============================="
  7.     
.     foreach outcome of global outcomes {
  8.         capture confirm variable `outcome'
  9.         if _rc != 0 {
 10.             di as error "Outcome `outcome' not foun
> d. Skipping."
 11.             continue
 12.         }
 13.         
.         quietly count if specialty_group == `spec' & t
> reated_state == 1 & !missing(`outcome')
 14.         if (r(N) == 0) {
 15.             di as error "  `outcome': no treated ob
> servations for `spec_name'."
 16.             continue
 17.         }
 18.         
.         quietly count if specialty_group == `spec' & t
> reated_state == 0 & !missing(`outcome')
 19.         if (r(N) == 0) {
 20.             di as error "  `outcome': no control ob
> servations for `spec_name'."
 21.             continue
 22.         }
 23.         
.         di ""
 24.         di "--- Outcome: `outcome' ---"
 25.         
.         capture noisily did_imputation `outcome' progr
> am_numeric_id year year_expanded ///
>             [aw=total_population_10] if specialty_grou
> p == `spec', ///
>             horizons(0/5) pretrend(5) fe(program_numer
> ic_id year) ///
>             cluster(state_id) minn(0)
 26.         
.         if (_rc != 0) {
 27.             di as error "did_imputation failed. Err
> or code `_rc'."
 28.             continue
 29.         }
 30.         
.         local coef = _b[tau0]
 31.         local se   = _se[tau0]
 32.         local tstat = `coef' / `se'
 33.         local pvalue = 2*ttail(e(df_r), abs(`tstat'
> ))
 34.         
.         local tau_sum = 0
 35.         local tau_n = 0
 36.         forval h = 0/5 {
 37.             capture scalar __tmp = _b[tau`h']
 38.             if (_rc == 0) {
 39.                 local tau_sum = `tau_sum' + __tmp
 40.                 local tau_n = `tau_n' + 1
 41.             }
 42.         }
 43.         if (`tau_n' > 0) local avg_treat = `tau_sum
> ' / `tau_n'
 44.         else local avg_treat = .
 45.         
.         local pretrend_p = .
 46.         local treat_p = .
 47.         capture noisily test pre1 pre2 pre3 pre4 pr
> e5
 48.         if (_rc == 0) local pretrend_p = r(p)
 49.         
.         capture noisily test tau0 tau1 tau2 tau3 tau4 
> tau5
 50.         if (_rc == 0) local treat_p = r(p)
 51.         
.         * Calculate baseline mean (pre-treatment obser
> vations for this specialty in treated states)
.         quietly summarize `outcome' if specialty_group
>  == `spec' & treated_state == 1 & year < year_expanded
>  [aw=total_population_10]
 52.         local baseline_mean = r(mean)
 53.         if missing(`baseline_mean') | `baseline_mea
> n' == 0 {
 54.             local baseline_mean = 1
 55.         }
 56.         local pct_effect = (`avg_treat' / `baseline
> _mean') * 100
 57.         if `pct_effect' < -100 {
 58.             local pct_effect = -100
 59.         }
 60.         
.         local n_programs = .
 61.         local n_states = .
 62.         capture levelsof program_numeric_id if spec
> ialty_group == `spec' & !missing(`outcome'), local(act
> ive_programs)
 63.         if (_rc == 0) local n_programs : word count
>  `active_programs'
 64.         
.         capture levelsof state_id if specialty_group =
> = `spec' & !missing(`outcome'), local(active_states)
 65.         if (_rc == 0) local n_states : word count `
> active_states'
 66. 
.         * Compute national/total annual impact for ann
> otation, restricted to this specialty group.
.         * matched (raw): avg_treat * N treated program
> s in this specialty.
.         * per_100k:      avg_treat * sum(state_pop acr
> oss treated programs in this specialty) / 100k.
.         local national_effect = .
 67.         local has_national = 0
 68.         if "`outcome'" == "matched" {
 69.             quietly levelsof program_numeric_id if 
> specialty_group == `spec' & treated_state == 1 & !miss
> ing(`outcome'), local(_tprogs)
 70.             local n_tprogs : word count `_tprogs'
 71.             local national_effect = `avg_treat' * `
> n_tprogs'
 72.             local has_national = 1
 73.         }
 74.         else if strpos("`outcome'", "_per_100k") > 
> 0 {
 75.             preserve
 76.             keep if specialty_group == `spec' & tre
> ated_state == 1 & !missing(`outcome')
 77.             collapse (mean) total_population_10, by
> (program_numeric_id)
 78.             quietly summarize total_population_10
 79.             local sum_treated_prog_pop = r(sum)
 80.             restore
 81.             local national_effect = `avg_treat' * `
> sum_treated_prog_pop' / 100000
 82.             local has_national = 1
 83.         }
 84.         local national_text = cond(`has_national', 
> string(`national_effect', "%9.0fc"), "NA")
 85. 
.         post `did_results_spec' ("`spec_name'") ("`out
> come'") ///
>             (`coef') (`se') (`tstat') (`pvalue') (`avg
> _treat') ///
>             (`pretrend_p') (`treat_p') (`n_programs') 
> (`n_states')
 86. 
.         di "ATT (tau0): " %9.3f `coef' "  SE: " %9.3f 
> `se' "  p = " %9.3f `pvalue'
 87.         di "Average post-treatment effect: " %9.3f 
> `avg_treat'
 88.         if (`has_national') di "Avg. annual aggrega
> te effect: " %15.0fc `national_effect'
 89.         
.         * ============================================
> =========================
.         * Event study plot
.         * ============================================
> =========================
.         matrix plot_coef = J(11, 3, .)
 90.         matrix colnames plot_coef = period coef se
 91.         local row = 1
 92.         forval h = 5(-1)1 {
 93.             matrix plot_coef[`row',1] = -`h'
 94.             capture matrix plot_coef[`row',2] = _b[
> pre`h']
 95.             capture matrix plot_coef[`row',3] = _se
> [pre`h']
 96.             local ++row
 97.         }
 98.         forval h = 0/5 {
 99.             matrix plot_coef[`row',1] = `h'
100.             capture matrix plot_coef[`row',2] = _b[
> tau`h']
101.             capture matrix plot_coef[`row',3] = _se
> [tau`h']
102.             local ++row
103.         }
104.         preserve
105.         clear
106.         svmat plot_coef, names(col)
107.         keep if !missing(period)
108.         gen ci_upper = coef + 1.96*se
109.         gen ci_lower = coef - 1.96*se
110.         gen byte pre_period = (period < 0)
111.         gen byte post_period = (period >= 0)
112.         local avg_text = cond(`avg_treat' < ., stri
> ng(`avg_treat', "%9.2f"), "NA")
113.         local treat_text = cond(`treat_p' < ., stri
> ng(`treat_p', "%9.2f"), "NA")
114.         local baseline_text = string(`baseline_mean
> ', "%9.2f")
115.         local pct_text = string(`pct_effect', "%9.1
> f")
116.         local post_line ""
117.         if (`avg_treat' < .) {
118.             local post_line "(scatteri `avg_treat' 
> 0 `avg_treat' 5, recast(line) lpattern(dash) lcolor(re
> d) lwidth(medium))"
119.         }
120.         local short = "${short_`outcome'}"
121.         local label = "${label_`outcome'}"
122.         if ("`label'" == "") {
123.             local label = "`outcome'"
124.         }
125.         local prefix : display %02.0f `plotnum'
126.         local ytitle_str "Treatment Effect (differe
> nce-in-differences)"
127.         local plot_title "Event Study: `spec_name' 
> - `label'"
128.         * Calculate annotation position dynamically
.         quietly summarize ci_upper
129.         local y_annot = r(max) * 0.9
130.         local x_annot = -2
131.         * Adjust for per 100k outcomes
.         if (strpos("`short'", "_100k") > 0) {
132.             local ytitle_str "Treatment Effect (per
>  100,000 population)"
133.             local x_annot = -2
134.         }
135.         if ("`outcome'" == "matched") {
136.             local ytitle_str "Treatment Effect (num
> ber of residency positions)"
137.         }
138.         * Build text annotations.
.         * Main annotation (left): baseline mean, post 
> avg, p-value.
.         * Extra annotation at x = 3, same y-level: nat
> ional/total impact (residency positions
.         * for raw matched; additional doctors national
> ly for per-100k).
.         local main_text `"text(`y_annot' `x_annot' `"B
> aseline Mean: `baseline_text'"' `"Post avg = `avg_text
> ' (`pct_text'%)"' `"p-value = `treat_text'"', size(lar
> ge))"'
139.         local extra_text ""
140.         if ("`outcome'" == "matched") {
141.             local extra_text `"text(`y_annot' 3 `"A
> vg. annual change in"' `"residency positions:"' `"`nat
> ional_text'"', size(large))"'
142.         }
143.         else if (strpos("`short'", "_100k") > 0) {
144.             local extra_text `"text(`y_annot' 3 `"A
> vg. annual change in"' `"doctors nationally:"' `"`nati
> onal_text'"', size(large))"'
145.         }
146.         twoway ///
>             (rarea ci_upper ci_lower period if pre_per
> iod, fcolor(dkgreen%45) lcolor(dkgreen%45) lwidth(none
> )) ///
>             (rarea ci_upper ci_lower period if post_pe
> riod, fcolor(maroon%45) lcolor(maroon%45) lwidth(none)
> ) ///
>             (line coef period if pre_period, lcolor(dk
> green) lwidth(medium)) ///
>             (line coef period if post_period, lcolor(m
> aroon) lwidth(medium)) ///
>             (scatter coef period if pre_period, mcolor
> (dkgreen) msymbol(circle) msize(medlarge)) ///
>             (scatter coef period if post_period, mcolo
> r(maroon) msymbol(circle) msize(medlarge)) ///
>             `post_line' ///
>             , ///
>             xline(-0.5, lcolor(black) lpattern(solid) 
> lwidth(thin)) ///
>             yline(0, lcolor(black) lpattern(solid) lwi
> dth(thin)) ///
>             xlabel(-5(1)5, labsize(small)) ///
>             ylabel(#10, labsize(small) format(%9.3f)) 
> ///
>             xtitle("Years relative to Medicaid expansi
> on", size(small)) ///
>             ytitle("`ytitle_str'", size(small)) ///
>             `main_text' ///
>             `extra_text' ///
>             legend(off) ///
>             graphregion(color(white)) plotregion(color
> (white))
147.         
.         * Clean specialty name for filename
.         local spec_clean = subinstr("`spec_name'", " "
> , "_", .)
148.         local spec_clean = subinstr("`spec_clean'",
>  "/", "_", .)
149.         
.         graph export "${figdir}/`prefix'-did_`short'_`
> spec_clean'_event.png", as(png) replace width(1200) he
> ight(800)
