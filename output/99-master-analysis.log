. capture noisily do "${progdir}/11-dd-analysis-hetero-bys
> pecialty.do"

. /*
> Heterogeneity Analysis by Urban/Rural Classification - B
> y Specialty Group
> Date: January 27th, 2026
> Purpose: Investigate heterogeneity in treatment effects 
> by urban/rural within each specialty group
> Urban areas: RUCA codes 1, 2, 3
> Rural areas: RUCA codes > 3
> */
. 
. clear all

. set more off

. 
. * ------------------------------------------------------
> -------------------
. * Define paths
. * ------------------------------------------------------
> -------------------
. global topdir "/Users/hhadah/Documents/GiT/residency-med
> icaid-expansion"

. global datadir "${topdir}/data/datasets"

. global raw "${topdir}/data/raw"

. global figdir "${topdir}/output/figures"

. global tabdir "${topdir}/output/tables"

. global latex_figdir "${topdir}/my_paper/figures"

. 
. * Open log file
. log using "${topdir}/output/11-dd-analysis-hetero-byspec
> ialty.log", replace
----------------------------------------------------------
      name:  <unnamed>
       log:  /Users/hhadah/Documents/GiT/residency-medicai
> d-expansion/output/11-dd-analysis-hetero-byspecialty.log
  log type:  text
 opened on:  27 Jan 2026, 19:44:34

. 
. cap mkdir "${figdir}"

. cap mkdir "${tabdir}"

. cap mkdir "${latex_figdir}"

. 
. * ------------------------------------------------------
> -------------------
. * Load cleaned data
. * ------------------------------------------------------
> -------------------
. use "${datadir}/cleaned_residency_medicaid.dta", clear

. 
. *=======================================================
> ========================
. * Data Setup
. *=======================================================
> ========================
. 
. * Use gen_specialty_alt for specialty grouping
. capture confirm variable gen_specialty_alt

. if _rc != 0 {
.     di as error "Variable gen_specialty_alt not found. C
> heck data."
.     exit 459
. }

. 
. * Create urban/rural group based on ruca_1_2010
. * 0 = Urban (RUCA codes 1, 2, 3), 1 = Rural (RUCA codes 
> > 3)
. gen urban_rural = (ruca_1_2010 > 3) if !missing(ruca_1_2
> 010)
(590 missing values generated)

. label define urban_rural_lab 0 "Urban" 1 "Rural"

. label values urban_rural urban_rural_lab

. 
. * Build specialty_group from gen_specialty_alt
. capture drop specialty_group specialty_group_name

. encode gen_specialty_alt, gen(specialty_group)

. gen str30 specialty_group_name = gen_specialty_alt

. 
. * Check for unclassified rows
. quietly count if missing(gen_specialty_alt) | gen_specia
> lty_alt == ""

. if r(N) > 0 {
.     di as error "WARNING: " r(N) " rows have missing gen
> _specialty_alt - dropping"
.     drop if missing(gen_specialty_alt) | gen_specialty_a
> lt == ""
. }

. 
. * Keep only observations with non-missing urban_rural
. keep if !missing(urban_rural)
(590 observations deleted)

. 
. * ------------------------------------------------------
> -------------------
. * Recreate treatment flags
. * ------------------------------------------------------
> -------------------
. capture confirm variable treated_state

. if _rc != 0 {
.     gen byte treated_state = (year_expanded < .)
. }

. 
. capture confirm variable post_expansion

. if _rc != 0 {
.     gen byte post_expansion = ///
>         (treated_state == 1 & year_expanded < . & year >
> = year_expanded)
. }

. 
. capture confirm variable treated_post

. if _rc != 0 {
.     gen byte treated_post = treated_state * post_expansi
> on
. }

. 
. capture confirm variable year_expanded

. if _rc != 0 {
.     di as error "Variable year_expanded not found. Re-ru
> n 02-data-cleaning.R."
.     exit 459
. }

. 
. * ------------------------------------------------------
> -------------------
. * Panel identifiers
. * ------------------------------------------------------
> -------------------
. egen program_numeric_id = group(state institution_code)

. encode state, gen(state_id)

