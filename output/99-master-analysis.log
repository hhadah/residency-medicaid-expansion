 93.     if (`pretrend_p' < .) di "Pretrend joint p-valu
> e: " %9.3f `pretrend_p'
 94.     if (`treat_p' < .)   di "Treatment joint p-valu
> e: " %9.3f `treat_p'
 95.     matrix plot_coef = J(11, 3, .)
 96.     matrix colnames plot_coef = period coef se
 97.     local row = 1
 98.     forval h = 5(-1)1 {
 99.         matrix plot_coef[`row',1] = -`h'
100.         capture matrix plot_coef[`row',2] = _b[pre`
> h']
101.         capture matrix plot_coef[`row',3] = _se[pre
> `h']
102.         local ++row
103.     }
104.     forval h = 0/5 {
105.         matrix plot_coef[`row',1] = `h'
106.         capture matrix plot_coef[`row',2] = _b[tau`
> h']
107.         capture matrix plot_coef[`row',3] = _se[tau
> `h']
108.         local ++row
109.     }
110.     preserve
111.     clear
112.     svmat plot_coef, names(col)
113.     keep if !missing(period)
114.     gen ci_upper = coef + 1.96*se
115.     gen ci_lower = coef - 1.96*se
116.     gen byte pre_period = (period < 0)
117.     gen byte post_period = (period >= 0)
118.     local avg_text = cond(`avg_treat' < ., string(`
> avg_treat', "%9.2f"), "NA")
119.     local treat_text = cond(`treat_p' < ., string(`
> treat_p', "%9.2f"), "NA")
120.     local baseline_text = string(`baseline_mean', "
> %9.2f")
121.     local pct_text = string(`pct_effect', "%9.1f")
122.     local post_line ""
123.     if (`avg_treat' < .) {
124.         local post_line "(scatteri `avg_treat' 0 `a
> vg_treat' 5, recast(line) lpattern(dash) lcolor(red) l
> width(medium))"
125.     }
126.     local short = "${short_`outcome'}"
127.     local label = "${label_`outcome'}"
128.     if ("`label'" == "") {
129.         local label = "`outcome'"
130.     }
131.     local prefix : display %02.0f `plotnum'
132.     local ytitle_str "Treatment Effect (difference-
> in-differences)"
133.     local plot_title "Event Study: `label'"
134.     quietly summarize ci_upper
135.     local y_annot = r(max) * 0.9
136.     local x_annot = -3
137.     if (strpos("`short'", "_100k") > 0) {
138.         local ytitle_str "Treatment Effect (per 100
> ,000 population)"
139.         local x_annot = -3
140.     }
141.     if ("`outcome'" == "matched") {
142.         local ytitle_str "Treatment Effect (number 
> of residency positions)"
143.     }
144.     local main_text `"text(`y_annot' `x_annot' `"Ba
> seline Mean: `baseline_text'"' `"Post avg = `avg_text'
>  (`pct_text'%)"' `"p-value = `treat_text'"', size(larg
> e))"'
145.     local extra_text ""
146.     if (`has_national') {
147.         local extra_text `"text(`y_annot' 3 `"Avg. 
> annual change in"' `"`national_label':"' `"`national_t
> ext'"', size(large))"'
148.     }
149.     twoway ///
>         (rarea ci_upper ci_lower period if pre_period,
>  fcolor(dkgreen%45) lcolor(dkgreen%45) lwidth(none)) /
> //
>         (rarea ci_upper ci_lower period if post_period
> , fcolor(maroon%45) lcolor(maroon%45) lwidth(none)) //
> /
>         (line coef period if pre_period, lcolor(dkgree
> n) lwidth(medium)) ///
>         (line coef period if post_period, lcolor(maroo
> n) lwidth(medium)) ///
>         (scatter coef period if pre_period, mcolor(dkg
> reen) msymbol(circle) msize(medlarge)) ///
>         (scatter coef period if post_period, mcolor(ma
> roon) msymbol(circle) msize(medlarge)) ///
>         `post_line' ///
>         , ///
>         xline(-0.5, lcolor(black) lpattern(solid) lwid
> th(thin)) ///
>         yline(0, lcolor(black) lpattern(solid) lwidth(
> thin)) ///
>         xlabel(-5(1)5, labsize(small)) ///
>         ylabel(#8, labsize(small) format(%9.2f)) ///
>         xtitle("Years relative to Medicaid expansion",
>  size(small)) ///
>         ytitle("`ytitle_str'", size(small)) ///
>         `main_text' ///
>         `extra_text' ///
>         legend(off) ///
>         graphregion(color(white)) plotregion(color(whi
> te))
150.     graph export "${figdir}/`prefix'-did_`short'_po
> pcnt_event.png", as(png) replace width(1200) height(80
> 0)
151.     graph export "${latex_figdir}/`prefix'-did_`sho
> rt'_popcnt_event.png", as(png) replace width(1200) hei
> ght(800)
152.     restore
153.     local ++plotnum
154. }

