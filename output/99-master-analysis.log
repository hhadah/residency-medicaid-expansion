. capture noisily do "${progdir}/05-dd-analysis.do"

. * =============================================================================
. * Difference-in-Differences Analysis (no triple DDD)
. * Outcomes: quota, matched, unmatched (quota - matched)
. * Event-study plotting follows prior scheme (pre/post shading + bands)
. * =============================================================================
. 
. clear all

. set more off

. 
. * -------------------------------------------------------------------------
. * Define paths
. * -------------------------------------------------------------------------
. global topdir "/Users/hhadah/Projects/GiT/residency-medicaid-expansion"

. global datadir "${topdir}/data/datasets"

. global figdir "${topdir}/output/figures"

. global tabdir "${topdir}/output/tables"

. global latex_figdir "${topdir}/my_paper/figures"

. 
. cap mkdir "${figdir}"

. cap mkdir "${tabdir}"

. cap mkdir "${latex_figdir}"

. 
. * -------------------------------------------------------------------------
. * Load cleaned data (produced by 02-data-cleaning.R)
. * -------------------------------------------------------------------------
. use "${datadir}/cleaned_program_residency_medicaid.dta", clear

. 
. * -------------------------------------------------------------------------
. * Panel identifiers
. * -------------------------------------------------------------------------
. egen program_numeric_id = group(state institution_code)

. encode state, gen(state_id)

. 
. xtset program_numeric_id year

Panel variable: program_numeric_id (strongly balanced)
 Time variable: year, 2010 to 2019
         Delta: 1 unit

. 
. * -------------------------------------------------------------------------
. * Outcomes and labels
. * -------------------------------------------------------------------------
. global outcomes "matched_per_100k quota_per_100k"

. global label_quota_100k "Residency Quota Positions per 100k Population"

. global label_matched_100k "Matched Residency Positions per 100k Population"

. global label_quota_per_100k "Residency Quota Positions per 100k Population"

. global label_matched_per_100k "Matched Residency Positions per 100k Population"

. 
. global short_quota_100k "quota_100k"

. global short_matched_100k "matched_100k"

. global short_quota_per_100k "quota_per_100k"

. global short_matched_per_100k "matched_per_100k"

. 
. * -------------------------------------------------------------------------
. * Store DID estimates
. * -------------------------------------------------------------------------
. tempname did_results

. tempfile did_results_file

. postfile `did_results' str12 outcome double coef se tstat pvalue avg_treat ///
>     pretrend_p treat_p n_programs n_states using "`did_results_file'", replace
(file /var/folders/yk/l30p1rcd2fsfx74wfvs62cmh0000gn/T//S_05029.000001 not found)

. 
. 
. local plotnum = 5

. foreach outcome of global outcomes {
  2.     capture confirm variable `outcome'
  3.     if _rc != 0 {
  4.         di as error "Outcome `outcome' not found. Skipping."
  5.         continue
  6.     }
  7.     quietly count if treated_state == 1 & !missing(`outcome')
  8.     if (r(N) == 0) {
  9.         di as error "Outcome `outcome': no treated observations with data."
 10.         continue
 11.     }
 12.     quietly count if treated_state == 0 & !missing(`outcome')
 13.     if (r(N) == 0) {
 14.         di as error "Outcome `outcome': no control observations with data."
 15.         continue
 16.     }
 17.     di ""
 18.     di "========================================================================="
 19.     di "DID ANALYSIS: ${label_`outcome'}"
 20.     di "Outcome variable: `outcome'"
 21.     di "========================================================================="
 22.     di ""
 23.     capture noisily did_imputation `outcome' program_numeric_id year year_expanded  [aw=total_population_10], ///
>         horizons(0/5) pretrend(5) fe(program_numeric_id year) ///
>         cluster(state_id) minn(0)
 24.     if (_rc != 0) {
 25.         di as error "did_imputation failed for outcome `outcome'. Error code `_rc'."
 26.         continue
 27.     }
 28.     local coef = _b[tau0]
 29.     local se   = _se[tau0]
 30.     local tstat = `coef' / `se'
 31.     local pvalue = 2*ttail(e(df_r), abs(`tstat'))
 32.     local tau_sum = 0
 33.     local tau_n = 0
 34.     forval h = 0/5 {
 35.         capture scalar __tmp = _b[tau`h']
 36.         if (_rc == 0) {
 37.             local tau_sum = `tau_sum' + __tmp
 38.             local tau_n = `tau_n' + 1
 39.         }
 40.     }
 41.     if (`tau_n' > 0) local avg_treat = `tau_sum' / `tau_n'
 42.     else local avg_treat = .
 43.     local pretrend_p = .
 44.     local treat_p = .
 45.     capture noisily test pre1 pre2 pre3 pre4 pre5
 46.     if (_rc == 0) {
 47.         local pretrend_p = r(p)
 48.     }
 49.     capture noisily test tau0 tau1 tau2 tau3 tau4 tau5
 50.     if (_rc == 0) {
 51.         local treat_p = r(p)
 52.     }
 53.     * Calculate baseline mean (pre-treatment observations in treated states)
.     quietly summarize `outcome' if treated_state == 1 & year < year_expanded [aw=total_population_10]
 54.     local baseline_mean = r(mean)
 55.     if missing(`baseline_mean') | `baseline_mean' == 0 {
 56.         local baseline_mean = 1
 57.     }
 58.     local pct_effect = (`avg_treat' / `baseline_mean') * 100
 59.     if `pct_effect' < -100 {
 60.         local pct_effect = -100
 61.     }
 62.     local n_programs = .
 63.     local n_states = .
 64.     capture levelsof program_numeric_id if !missing(`outcome'), local(active_programs)
 65.     if (_rc == 0) {
 66.         local n_programs : word count `active_programs'
 67.     }
 68.     capture levelsof state_id if !missing(`outcome'), local(active_states)
 69.     if (_rc == 0) {
 70.         local n_states : word count `active_states'
 71.     }
 72.     post `did_results' ("`outcome'") ///
>         (`coef') (`se') (`tstat') (`pvalue') (`avg_treat') ///
>         (`pretrend_p') (`treat_p') (`n_programs') (`n_states')
 73.     di "ATT (tau0): " %9.3f `coef' "  SE: " %9.3f `se' "  p = " %9.3f `pvalue'
 74.     di "Average post-treatment effect: " %9.3f `avg_treat'
 75.     if (`pretrend_p' < .) di "Pretrend joint p-value: " %9.3f `pretrend_p'
 76.     if (`treat_p' < .)   di "Treatment joint p-value: " %9.3f `treat_p'
 77.     matrix plot_coef = J(11, 3, .)
 78.     matrix colnames plot_coef = period coef se
 79.     local row = 1
 80.     forval h = 5(-1)1 {
 81.         matrix plot_coef[`row',1] = -`h'
 82.         capture matrix plot_coef[`row',2] = _b[pre`h']
 83.         capture matrix plot_coef[`row',3] = _se[pre`h']
 84.         local ++row
 85.     }
 86.     forval h = 0/5 {
 87.         matrix plot_coef[`row',1] = `h'
 88.         capture matrix plot_coef[`row',2] = _b[tau`h']
 89.         capture matrix plot_coef[`row',3] = _se[tau`h']
 90.         local ++row
 91.     }
 92.     preserve
 93.     clear
 94.     svmat plot_coef, names(col)
 95.     keep if !missing(period)
 96.     gen ci_upper = coef + 1.96*se
 97.     gen ci_lower = coef - 1.96*se
 98.     gen byte pre_period = (period < 0)
 99.     gen byte post_period = (period >= 0)
100.     local avg_text = cond(`avg_treat' < ., string(`avg_treat', "%9.2f"), "NA")
101.     local treat_text = cond(`treat_p' < ., string(`treat_p', "%9.2f"), "NA")
102.     local baseline_text = string(`baseline_mean', "%9.2f")
103.     local pct_text = string(`pct_effect', "%9.1f")
104.     local post_line ""
105.     if (`avg_treat' < .) {
106.         local post_line "(scatteri `avg_treat' 0 `avg_treat' 5, recast(line) lpattern(dash) lcolor(red) lwidth(medium))"
107.     }
108.     local short = "${short_`outcome'}"
109.         local label = "${label_`outcome'}"
110.         if ("`label'" == "") {
111.                 local label = "`outcome'"
112.         }
113.     local prefix : display %02.0f `plotnum'
114.     local ytitle_str "Treatment Effect (difference-in-differences)"
115.     local plot_title "Event Study: `label'"
116.     * Calculate annotation position dynamically
.     quietly summarize ci_upper
117.     local y_annot = r(max) * 0.9
118.     local x_annot = -3
119.     * Adjust for per 100k outcomes
.     if (strpos("`short'", "_100k") > 0) {
120.         local ytitle_str "Treatment Effect (per 100,000 population)"
121.         local x_annot = -3
122.     }
123.     twoway ///
>         (rarea ci_upper ci_lower period if pre_period, fcolor(dkgreen%45) lcolor(dkgreen%45) lwidth(none)) ///
>         (rarea ci_upper ci_lower period if post_period, fcolor(maroon%45) lcolor(maroon%45) lwidth(none)) ///
>         (line coef period if pre_period, lcolor(dkgreen) lwidth(medium)) ///
>         (line coef period if post_period, lcolor(maroon) lwidth(medium)) ///
>         (scatter coef period if pre_period, mcolor(dkgreen) msymbol(circle) msize(medlarge)) ///
>         (scatter coef period if post_period, mcolor(maroon) msymbol(circle) msize(medlarge)) ///
>         `post_line' ///
>         , ///
>         xline(-0.5, lcolor(black) lpattern(solid) lwidth(thin)) ///
>         yline(0, lcolor(black) lpattern(solid) lwidth(thin)) ///
>         xlabel(-5(1)5, labsize(small)) ///
>         ylabel(#8, labsize(small) format(%9.2f)) ///
>         xtitle("Years relative to Medicaid expansion", size(small)) ///
>         ytitle("`ytitle_str'", size(small)) ///
>         text(`y_annot' `x_annot' `"Baseline Mean: `baseline_text'"' `"Post avg = `avg_text' (`pct_text'%)"' `"p-value = `treat_text'"', size(large)) ///
>         legend(off) ///
>         graphregion(color(white)) plotregion(color(white))
124.     graph export "${figdir}/`prefix'-did_`short'_event.png", as(png) replace width(1200) height(800)
125.     graph export "${latex_figdir}/`prefix'-did_`short'_event.png", as(png) replace width(1200) height(800)
126.     restore
127.     local ++plotnum
128. }

