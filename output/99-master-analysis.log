. local plotnum = 31

. foreach outcome in asinh_dgme asinh_ime {
  2.     foreach grp in volume notvolume {
  3. 
.         use "`master'", clear
  4.         if "`grp'" == "volume"    keep if treated_state == 0 | (treated_state == 1 & gme_vol == 1)
  5.         if "`grp'" == "notvolume" keep if treated_state == 0 | (treated_state == 1 & gme_notvol == 1)
  6. 
.         quietly count if treated_state == 1 & !missing(`outcome')
  7.         if (r(N) == 0) {
  8.             di as error "No treated obs for `outcome' / `grp' -- skipping."
  9.             local ++plotnum
 10.             continue
 11.         }
 12. 
.         di ""
 13.         di "========================================================================="
 14.         di "FIRST STAGE: `outcome' -- `grp'-formula expansion states vs controls"
 15.         di "========================================================================="
 16. 
.         capture noisily did_imputation `outcome' provider_numeric_id fiscal_year year_expanded, ///
>             horizons(0/5) pretrend(5) fe(provider_numeric_id fiscal_year) ///
>             cluster(state_id) minn(0) autosample
 17.         if (_rc != 0) {
 18.             di as error "did_imputation failed for `outcome' / `grp' (rc=`_rc'). Skipping."
 19.             local ++plotnum
 20.             continue
 21.         }
 22. 
.         * Average post ATT (tau0..5) and joint tests
.         local tau_sum = 0
 23.         local tau_n = 0
 24.         forval h = 0/5 {
 25.             capture scalar __b = _b[tau`h']
 26.             if (_rc == 0) {
 27.                 local tau_sum = `tau_sum' + __b
 28.                 local tau_n = `tau_n' + 1
 29.             }
 30.         }
 31.         local avg_treat = cond(`tau_n' > 0, `tau_sum'/`tau_n', .)
 32.         local pretrend_p = .
 33.         local treat_p = .
 34.         capture test pre1 pre2 pre3 pre4 pre5
 35.         if (_rc == 0) local pretrend_p = r(p)
 36.         capture test tau0 tau1 tau2 tau3 tau4 tau5
 37.         if (_rc == 0) local treat_p = r(p)
 38. 
.         quietly summarize `outcome' if treated_state == 1 & fiscal_year < year_expanded
 39.         local baseline = r(mean)
 40.         local pct = cond(!missing(`baseline') & `baseline' != 0, 100*`avg_treat'/`baseline', .)
 41. 
.         local nh = .
 42.         local ns = .
 43.         capture levelsof provider_numeric_id if !missing(`outcome'), local(hh)
 44.         if (_rc == 0) local nh : word count `hh'
 45.         capture levelsof state_id if !missing(`outcome'), local(ss)
 46.         if (_rc == 0) local ns : word count `ss'
 47. 
.         post `fs' ("`outcome'") ("`grp'") (`avg_treat') (`treat_p') (`pretrend_p') ///
>             (`baseline') (`pct') (`nh') (`ns')
 48.         di as result "`outcome' / `grp': avg post = " %7.3f `avg_treat' ///
>             "  joint p = " %6.3f `treat_p' "  (pretrend p = " %5.3f `pretrend_p' ")"
 49. 
.         * ---- Event-study figure via shared helpers ----
.         * No in-graph title (INV-12): the LaTeX subcaption labels the panel.
.         * Semantic name: appx-firststage-{dgme|ime}-{volume|nonresp}
.         local fbase = cond("`outcome'"=="asinh_dgme", "dgme", "ime")
 50.         local fgrp  = cond("`grp'"=="volume", "volume", "nonresp")
 51.         local outfname = "appx-firststage-`fbase'-`fgrp'"
 52.         _fillcoef
 53.         _esplot "`outfname'" "Treatment Effect (asinh dollars)" "" `avg_treat' `baseline' `pct' `treat_p' `pretrend_p'
 54. 
.         local ++plotnum
 55.     }
 56. }
