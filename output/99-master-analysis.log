. di ""


. di "========================================================================="
=========================================================================

. di "HETEROGENEITY ANALYSIS: By Urban/Rural Classification"
HETEROGENEITY ANALYSIS: By Urban/Rural Classification

. di "Urban vs Rural"
Urban vs Rural

. di "========================================================================="
=========================================================================

. di ""


. 
. local plotnum = 7

. 
. foreach outcome of global outcomes {
  2.     
.     capture confirm variable `outcome'
  3.     if _rc != 0 {
  4.         di as error "Outcome `outcome' not found. Skipping."
  5.         continue
  6.     }
  7.     
.     quietly count if urban_rural == 0 & treated_state == 1 & !missing(`outcome')
  8.     if (r(N) == 0) {
  9.         di as error "Outcome `outcome': no treated urban observations."
 10.         continue
 11.     }
 12.     
.     quietly count if urban_rural == 1 & treated_state == 1 & !missing(`outcome')
 13.     if (r(N) == 0) {
 14.         di as error "Outcome `outcome': no treated rural observations."
 15.         continue
 16.     }
 17.     
.     di ""
 18.     di "========================================================================="
 19.     di "HETEROGENEITY ANALYSIS: ${label_`outcome'}"
 20.     di "Outcome variable: `outcome'"
 21.     di "========================================================================="
 22.     di ""
 23.     
.     * Run did_imputation with heterogeneous effects by urban/rural (0 = urban, 1 = rural)
.     capture noisily did_imputation `outcome' program_numeric_id year year_expanded [aw=total_population_10], ///
>         horizons(0/5) pretrend(5) ///
>         cluster(state_id) ///
>         hetby(urban_rural) ///
>         fe(program_numeric_id year) ///
>         minn(0) autosample
 24.     
.     if (_rc != 0) {
 25.         di as error "did_imputation failed for outcome `outcome'. Error code `_rc'."
 26.         continue
 27.     }
 28.     
.     * =====================
.     * Post-treatment averages and p-value tests
.     * =====================
.     * Test pretrend assumption
.     test pre1 pre2 pre3 pre4 pre5
 29.     local pretrend_p = r(p)
 30. 
.     * Calculate average effects for both groups
.     local avg_urban = (_b[tau0_0] + _b[tau1_0] + _b[tau2_0] + _b[tau3_0] + _b[tau4_0] + _b[tau5_0])/6
 31.     local avg_rural = (_b[tau0_1] + _b[tau1_1] + _b[tau2_1] + _b[tau3_1] + _b[tau4_1] + _b[tau5_1])/6
 32.     local avg_diff = `avg_rural' - `avg_urban'
 33. 
.     * Test difference in post averages and get p-value
.     testnl ((_b[tau0_1] + _b[tau1_1] + _b[tau2_1] + _b[tau3_1] + _b[tau4_1] + _b[tau5_1])/6) - ((_b[tau0_0] + _b[tau1_0] + _b[tau2_0] + _b[tau3_0] + _b[tau4_0] + _b[tau5_0])/6) = 0
 34.     local avg_diff_p = r(p)
 35. 
.     * Joint test of heterogeneity across all periods
.     test (tau0_0 = tau0_1) (tau1_0 = tau1_1) (tau2_0 = tau2_1) (tau3_0 = tau3_1) (tau4_0 = tau4_1) (tau5_0 = tau5_1)
 36.     local joint_het_p = r(p)
 37. 
.     * Test individual group significance (joint test for post-treatment effects)
.     test tau0_0 tau1_0 tau2_0 tau3_0 tau4_0 tau5_0
 38.     local urban_p = r(p)
 39.     test tau0_1 tau1_1 tau2_1 tau3_1 tau4_1 tau5_1
 40.     local rural_p = r(p)
 41. 
.     * Calculate baseline means (pre-treatment observations in estimation sample)
.     quietly summarize `outcome' if urban_rural == 0 & year < year_expanded & e(sample) [aw=total_population_10]
 42.     local baseline_urban = r(mean)
 43.     if missing(`baseline_urban') | `baseline_urban' == 0 {
 44.         local baseline_urban = 1
 45.     }
 46.     
.     quietly summarize `outcome' if urban_rural == 1 & year < year_expanded & e(sample) [aw=total_population_10]
 47.     local baseline_rural = r(mean)
 48.     if missing(`baseline_rural') | `baseline_rural' == 0 {
 49.         local baseline_rural = 1
 50.     }
 51.     
.     local pct_urban = (`avg_urban' / `baseline_urban') * 100
 52.     local pct_rural = (`avg_rural' / `baseline_rural') * 100
 53.     if `pct_urban' < -100 local pct_urban = -100
 54.     if `pct_rural' < -100 local pct_rural = -100
 55. 
.     * Store values in locals for annotation
.     local text_urban = string(`avg_urban', "%9.2f")
 56.     local text_rural = string(`avg_rural', "%9.2f")
 57.     local text_urban_p = string(`urban_p', "%9.2f")
 58.     local text_rural_p = string(`rural_p', "%9.2f")
 59.     local text_het = string(`joint_het_p', "%9.2f")
 60.     local text_avg_diff = string(`avg_diff', "%9.2f")
 61.     local text_avg_diff_p = string(`avg_diff_p', "%9.2f")
 62.     local text_baseline_urban = string(`baseline_urban', "%9.2f")
 63.     local text_baseline_rural = string(`baseline_rural', "%9.2f")
 64.     local text_pct_urban = string(`pct_urban', "%9.1f")
 65.     local text_pct_rural = string(`pct_rural', "%9.1f")
 66.     
.     di "Average urban effect: " %9.3f `avg_urban' " (p = " %9.3f `urban_p' ")"
 67.     di "Average rural effect: " %9.3f `avg_rural' " (p = " %9.3f `rural_p' ")"
 68.     di "Difference (rural - urban): " %9.3f `avg_diff' " (p = " %9.3f `avg_diff_p' ")"
 69.     di "Joint heterogeneity test p-value: " %9.3f `joint_het_p'
 70.     di "Pretrend joint p-value: " %9.3f `pretrend_p'
 71. 
.     * =====================
.     * Plotting with annotation
.     * =====================
.     * Create matrices for both groups (0 = urban, 1 = rural)
.     matrix urban = J(11, 5, .)  // 5 pretrends + 6 treatment periods
 72.     matrix rural = J(11, 5, .)
 73.     matrix colnames urban = period coef se ci_upper ci_lower
 74.     matrix colnames rural = period coef se ci_upper ci_lower
 75.     
.     local row = 1
 76.     
.     * Pretrend coefficients (same for both groups)
.     forval h = 5(-1)1 {
 77.         * Urban counties
.         matrix urban[`row',1] = -`h'
 78.         matrix urban[`row',2] = _b[pre`h']
 79.         matrix urban[`row',3] = _se[pre`h']
 80.         matrix urban[`row',4] = _b[pre`h'] + 1.96*_se[pre`h']
 81.         matrix urban[`row',5] = _b[pre`h'] - 1.96*_se[pre`h']
 82.         
.         * Rural counties (same pretrends)
.         matrix rural[`row',1] = -`h'
 83.         matrix rural[`row',2] = _b[pre`h']
 84.         matrix rural[`row',3] = _se[pre`h']  
 85.         matrix rural[`row',4] = _b[pre`h'] + 1.96*_se[pre`h']
 86.         matrix rural[`row',5] = _b[pre`h'] - 1.96*_se[pre`h']
 87.         
.         local ++row
 88.     }
 89.     
.     * Treatment coefficients - separate by group
.     forval h = 0/5 {
 90.         * Urban (tau_0)
.         matrix urban[`row',1] = `h'
 91.         matrix urban[`row',2] = _b[tau`h'_0]
 92.         matrix urban[`row',3] = _se[tau`h'_0]
 93.         matrix urban[`row',4] = _b[tau`h'_0] + 1.96*_se[tau`h'_0]
 94.         matrix urban[`row',5] = _b[tau`h'_0] - 1.96*_se[tau`h'_0]
 95.         
.         * Rural (tau_1)
.         matrix rural[`row',1] = `h'
 96.         matrix rural[`row',2] = _b[tau`h'_1]
 97.         matrix rural[`row',3] = _se[tau`h'_1]
 98.         matrix rural[`row',4] = _b[tau`h'_1] + 1.96*_se[tau`h'_1]
 99.         matrix rural[`row',5] = _b[tau`h'_1] - 1.96*_se[tau`h'_1]
100.         
.         local ++row
101.     }
102.     
.     * Convert matrices to variables for plotting
.     preserve
103.     clear
104.     svmat urban, names(urb)
105.     svmat rural, names(rur)
106.     
.     * Rename variables
.     rename urb1 urb_period
107.     rename urb2 urb_coef  
108.     rename urb3 urb_se
109.     rename urb4 urb_ci_upper
110.     rename urb5 urb_ci_lower
111.     
.     rename rur1 rur_period
112.     rename rur2 rur_coef
113.     rename rur3 rur_se  
114.     rename rur4 rur_ci_upper
115.     rename rur5 rur_ci_lower
116.     
.     * Create pre/post indicators for plotting
.     gen urb_pre = (urb_period < 0)
117.     gen urb_post = (urb_period >= 0)
118.     gen rur_pre = (rur_period < 0)  
119.     gen rur_post = (rur_period >= 0)
120. 
.     * Calculate dynamic annotation coordinates using maximum upper confidence intervals from both groups
.     quietly summarize urb_ci_upper
121.     local max1 = r(max)
122.     quietly summarize rur_ci_upper
123.     local max2 = r(max) 
124.     local y_annot = max(`max1', `max2') * 0.9
125.     local x_annot = -2
126.     
.     local short = "${short_`outcome'}"
127.     local label = "${label_`outcome'}"
128.     if ("`label'" == "") {
129.         local label = "`outcome'"
130.     }
131.     local prefix : display %02.0f `plotnum'
132.     local ytitle_str "Treatment Effect (difference-in-differences)"
133.     local plot_title "Heterogeneity: Urban vs Rural - `label'"
134.     
.     * Adjust for per 100k outcomes
.     if (strpos("`short'", "_100k") > 0) {
135.         local ytitle_str "Treatment Effect (per 100,000 population)"
136.         local x_annot = -2
137.     }
138.     
.     * Create combined plot using twoway, with annotation
.     twoway (rarea urb_ci_upper urb_ci_lower urb_period if urb_pre, fcolor("31 119 180%20") lcolor("31 119 180%20") lwidth(none)) ///
>            (rarea urb_ci_upper urb_ci_lower urb_period if urb_post, fcolor("31 119 180%20") lcolor("31 119 180%20") lwidth(none)) ///
>            (rarea rur_ci_upper rur_ci_lower rur_period if rur_pre, fcolor("255 127 14%25") lcolor("255 127 14%25") lwidth(none)) ///
>            (rarea rur_ci_upper rur_ci_lower rur_period if rur_post, fcolor("255 127 14%25") lcolor("255 127 14%25") lwidth(none)) ///
>            (line urb_coef urb_period if urb_pre, lcolor("31 119 180") lwidth(medium) lpattern(solid)) ///
>            (line urb_coef urb_period if urb_post, lcolor("31 119 180") lwidth(medium) lpattern(solid)) ///
>            (line rur_coef rur_period if rur_pre, lcolor("255 127 14") lwidth(medium) lpattern(dash)) ///
>            (line rur_coef rur_period if rur_post, lcolor("255 127 14") lwidth(medium) lpattern(dash)) ///
>            (scatter urb_coef urb_period if urb_pre, mcolor("31 119 180") msize(medium) msymbol(circle)) ///
>            (scatter urb_coef urb_period if urb_post, mcolor("31 119 180") msize(medium) msymbol(circle)) ///
>            (scatter rur_coef rur_period if rur_pre, mcolor("255 127 14") msize(medium) msymbol(triangle)) ///
>            (scatter rur_coef rur_period if rur_post, mcolor("255 127 14") msize(medium) msymbol(triangle)) ///
>            , ///
>            xline(-0.5, lcolor(black) lpattern(solid) lwidth(thin)) ///
>            yline(0, lcolor(black) lpattern(solid) lwidth(thin)) ///
>            xlabel(-5(1)5, labsize(small)) ///
>            ylabel(#10, labsize(small) format(%9.2f)) ///
>            xtitle("Years relative to Medicaid expansion", size(small)) ///
>            ytitle("`ytitle_str'", size(small)) ///
>            legend(order(9 11) label(9 "Urban") label(11 "Rural") ///
>                position(6) rows(1) size(small)) ///
>            text(`y_annot' `x_annot' `"Urban Avg: `text_urban' (p=`text_urban_p')"' `"Rural Avg: `text_rural' (p=`text_rural_p')"' `"Difference: `text_avg_diff' (p=`text_avg_diff_p')"', size(large)) /
> //
>            graphregion(color(white)) plotregion(color(white))
139.     
.     graph export "${figdir}/`prefix'-hetero_urbanrural_`short'_event.png", as(png) replace width(1200) height(800)
140.     graph export "${latex_figdir}/`prefix'-hetero_urbanrural_`short'_event.png", as(png) replace width(1200) height(800)
141.     
.     restore
142.     local ++plotnum
143. }

