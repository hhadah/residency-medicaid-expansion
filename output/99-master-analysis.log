 80.         local urban_national = `avg_urban' * `sum_u
> rban_pop' / 100000
 81.         local rural_national = `avg_rural' * `sum_r
> ural_pop' / 100000
 82.         local has_national = 1
 83.     }
 84.     local urban_national_text = cond(`has_national'
> , string(`urban_national', "%9.0fc"), "NA")
 85.     local rural_national_text = cond(`has_national'
> , string(`rural_national', "%9.0fc"), "NA")
