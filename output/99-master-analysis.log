 31.         local se   = _se[tau0]
 32.         local tstat = `coef' / `se'
 33.         local pvalue = 2*ttail(e(df_r), abs(`tstat'))
 34.         
.         local tau_sum = 0
 35.         local tau_n = 0
 36.         forval h = 0/5 {
 37.             capture scalar __tmp = _b[tau`h']
 38.             if (_rc == 0) {
 39.                 local tau_sum = `tau_sum' + __tmp
 40.                 local tau_n = `tau_n' + 1
 41.             }
 42.         }
 43.         if (`tau_n' > 0) local avg_treat = `tau_sum' 
> / `tau_n'
 44.         else local avg_treat = .
 45.         
.         local pretrend_p = .
 46.         local treat_p = .
 47.         capture noisily test pre1 pre2 pre3 pre4 pre5
 48.         if (_rc == 0) local pretrend_p = r(p)
 49.         
.         capture noisily test tau0 tau1 tau2 tau3 tau4 ta
> u5
 50.         if (_rc == 0) local treat_p = r(p)
 51.         
.         * Calculate baseline mean (pre-treatment observa
> tions for this specialty in treated states)
.         quietly summarize `outcome' if specialty_group =
> = `spec' & treated_state == 1 & year < year_expanded [aw
> =total_population_10]
 52.         local baseline_mean = r(mean)
 53.         if missing(`baseline_mean') | `baseline_mean'
>  == 0 {
 54.             local baseline_mean = 1
 55.         }
 56.         local pct_effect = (`avg_treat' / `baseline_m
> ean') * 100
 57.         if `pct_effect' < -100 {
 58.             local pct_effect = -100
 59.         }
 60.         
.         local n_programs = .
 61.         local n_states = .
 62.         capture levelsof program_numeric_id if specia
> lty_group == `spec' & !missing(`outcome'), local(active_
> programs)
 63.         if (_rc == 0) local n_programs : word count `
> active_programs'
 64.         
.         capture levelsof state_id if specialty_group == 
> `spec' & !missing(`outcome'), local(active_states)
 65.         if (_rc == 0) local n_states : word count `ac
> tive_states'
 66.         
.         post `did_results_spec' ("`spec_name'") ("`outco
> me'") ///
>             (`coef') (`se') (`tstat') (`pvalue') (`avg_t
> reat') ///
>             (`pretrend_p') (`treat_p') (`n_programs') (`
> n_states')
 67.         
.         di "ATT (tau0): " %9.3f `coef' "  SE: " %9.3f `s
> e' "  p = " %9.3f `pvalue'
 68.         di "Average post-treatment effect: " %9.3f `a
> vg_treat'
 69.         
.         * ==============================================
> =======================
.         * Event study plot
.         * ==============================================
> =======================
.         matrix plot_coef = J(11, 3, .)
 70.         matrix colnames plot_coef = period coef se
 71.         local row = 1
 72.         forval h = 5(-1)1 {
 73.             matrix plot_coef[`row',1] = -`h'
 74.             capture matrix plot_coef[`row',2] = _b[pr
> e`h']
 75.             capture matrix plot_coef[`row',3] = _se[p
> re`h']
 76.             local ++row
 77.         }
 78.         forval h = 0/5 {
 79.             matrix plot_coef[`row',1] = `h'
 80.             capture matrix plot_coef[`row',2] = _b[ta
> u`h']
 81.             capture matrix plot_coef[`row',3] = _se[t
> au`h']
 82.             local ++row
 83.         }
 84.         preserve
 85.         clear
 86.         svmat plot_coef, names(col)
 87.         keep if !missing(period)
 88.         gen ci_upper = coef + 1.96*se
 89.         gen ci_lower = coef - 1.96*se
 90.         gen byte pre_period = (period < 0)
 91.         gen byte post_period = (period >= 0)
 92.         local avg_text = cond(`avg_treat' < ., string
> (`avg_treat', "%9.2f"), "NA")
 93.         local treat_text = cond(`treat_p' < ., string
> (`treat_p', "%9.2f"), "NA")
 94.         local baseline_text = string(`baseline_mean',
>  "%9.2f")
 95.         local pct_text = string(`pct_effect', "%9.1f"
> )
 96.         local post_line ""
 97.         if (`avg_treat' < .) {
 98.             local post_line "(scatteri `avg_treat' 0 
> `avg_treat' 5, recast(line) lpattern(dash) lcolor(red) l
> width(medium))"
 99.         }
100.         local short = "${short_`outcome'}"
101.         local label = "${label_`outcome'}"
102.         if ("`label'" == "") {
103.             local label = "`outcome'"
104.         }
105.         local prefix : display %02.0f `plotnum'
106.         local ytitle_str "Treatment Effect (differenc
> e-in-differences)"
107.         local plot_title "Event Study: `spec_name' - 
> `label'"
108.         * Calculate annotation position dynamically
.         quietly summarize ci_upper
109.         local y_annot = r(max)
110.         local x_annot = -4
111.         * Adjust for per 100k outcomes
.         if (strpos("`short'", "_100k") > 0) {
112.             local ytitle_str "Treatment Effect (per 1
> 00,000 population)"
113.             local x_annot = -4
114.         }
115.         twoway ///
>             (rarea ci_upper ci_lower period if pre_perio
> d, fcolor(dkgreen%45) lcolor(dkgreen%45) lwidth(none)) /
> //
>             (rarea ci_upper ci_lower period if post_peri
> od, fcolor(maroon%45) lcolor(maroon%45) lwidth(none)) //
> /
>             (line coef period if pre_period, lcolor(dkgr
> een) lwidth(medium)) ///
>             (line coef period if post_period, lcolor(mar
> oon) lwidth(medium)) ///
>             (scatter coef period if pre_period, mcolor(d
> kgreen) msymbol(circle) msize(medlarge)) ///
>             (scatter coef period if post_period, mcolor(
> maroon) msymbol(circle) msize(medlarge)) ///
>             `post_line' ///
>             , ///
>             xline(-0.5, lcolor(black) lpattern(solid) lw
> idth(thin)) ///
>             yline(0, lcolor(black) lpattern(solid) lwidt
> h(thin)) ///
>             xlabel(-5(1)5, labsize(small)) ///
>             ylabel(#10, labsize(small) format(%9.3f)) //
> /
>             xtitle("Years relative to Medicaid expansion
> ", size(small)) ///
>             ytitle("`ytitle_str'", size(small)) ///
>             title("`plot_title'", size(small)) ///
>             text(`y_annot' `x_annot' `"Baseline Mean: `b
> aseline_text'"' `"Post avg = `avg_text' (`pct_text'%)"' 
> `"p-value = `treat_text'"', size(small)) ///
>             legend(off) ///
>             graphregion(color(white)) plotregion(color(w
> hite))
116.         
.         * Clean specialty name for filename
.         local spec_clean = subinstr("`spec_name'", " ", 
> "_", .)
117.         local spec_clean = subinstr("`spec_clean'", "
> /", "_", .)
118.         
.         graph export "${figdir}/`prefix'-did_`short'_`sp
> ec_clean'_event.png", as(png) replace width(1200) height
> (800)
119.         graph export "${latex_figdir}/`prefix'-did_`s
> hort'_`spec_clean'_event.png", as(png) replace width(120
> 0) height(800)
120.         restore
121.         local ++plotnum
122.     }
123. }
