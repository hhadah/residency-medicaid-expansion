. * Shared event-study plotting helpers (_esplot, _fillcoef)
. do "${topdir}/programs/_esplot-helpers.do"

. * =============================================================================
. * _esplot-helpers.do — shared event-study plotting helpers (single source).
. * Include from analysis scripts with:  do "${topdir}/programs/_esplot-helpers.do"
. * Requires globals: ${figdir}, ${latex_figdir}.
. *
. * _fillcoef [hmax]  : builds matrix plot_coef ((5+hmax+1) x 3: period coef se)
. *                     from stored pre1-pre5 / tau0-tau`hmax' (default hmax = 5).
. * _esplot args      : fname ytitle title avg baseline pct treatp pretrendp [hmax]
. *                     single-series event study (green pre / maroon post) with
. *                     annotation box; exports PNG (raster) and PDF (vector) to
. *                     both ${figdir} and ${latex_figdir}.
. * =============================================================================
. 
. capture program drop _fillcoef

. program define _fillcoef
  1.     args hmax
  2.     if ("`hmax'" == "") local hmax = 5
  3.     local nrows = 5 + `hmax' + 1
  4.     matrix plot_coef = J(`nrows', 3, .)
  5.     matrix colnames plot_coef = period coef se
  6.     local row = 1
  7.     forval h = 5(-1)1 {
  8.         matrix plot_coef[`row',1] = -`h'
  9.         capture matrix plot_coef[`row',2] = _b[pre`h']
 10.         capture matrix plot_coef[`row',3] = _se[pre`h']
 11.         local ++row
 12.     }
 13.     forval h = 0/`hmax' {
 14.         matrix plot_coef[`row',1] = `h'
 15.         capture matrix plot_coef[`row',2] = _b[tau`h']
 16.         capture matrix plot_coef[`row',3] = _se[tau`h']
 17.         local ++row
 18.     }
 19. end

. 
. capture program drop _esplot

. program define _esplot
  1.     args fname ytitle title avg baseline pct treatp pretrendp hmax
  2.     if ("`hmax'" == "") local hmax = 5
  3.     preserve
  4.     clear
  5.     svmat plot_coef, names(col)
  6.     keep if !missing(period)
  7.     gen ci_upper = coef + 1.96*se
  8.     gen ci_lower = coef - 1.96*se
  9.     gen byte pre_period  = (period < 0)
 10.     gen byte post_period = (period >= 0)
 11.     quietly summarize ci_upper
 12.     local y_annot = r(max)*0.92
 13.     local post_line ""
 14.     if (`avg' < .) local post_line "(scatteri `avg' 0 `avg' `hmax', recast(line) lpattern(dash) lcolor(red) lwidth(medium))"
 15.     local bl_t = string(`baseline', "%9.3f")
 16.     local av_t = string(`avg', "%9.3f")
 17.     local pc_t = string(`pct', "%9.1f")
 18.     local tp_t = cond(`treatp'    < ., string(`treatp',    "%4.2f"), "NA")
 19.     local pt_t = cond(`pretrendp' < ., string(`pretrendp', "%4.2f"), "NA")
 20.     local annot `"text(`y_annot' -4.5 `"Baseline mean: `bl_t'"' `"Post avg = `av_t' (`pc_t'%)"' `"Treatment p = `tp_t'"' `"Pre-trend p = `pt_t'"', placement(e) size(medsmall) justification(l
> eft))"'
 21.     twoway ///
>         (rarea ci_upper ci_lower period if pre_period,  fcolor(dkgreen%45) lcolor(dkgreen%45) lwidth(none)) ///
>         (rarea ci_upper ci_lower period if post_period, fcolor(maroon%45)  lcolor(maroon%45)  lwidth(none)) ///
>         (line coef period if pre_period,  lcolor(dkgreen) lwidth(medium)) ///
>         (line coef period if post_period, lcolor(maroon)  lwidth(medium)) ///
>         (scatter coef period if pre_period,  mcolor(dkgreen) msymbol(circle) msize(medlarge)) ///
>         (scatter coef period if post_period, mcolor(maroon)  msymbol(circle) msize(medlarge)) ///
>         `post_line' ///
>         , xline(-0.5, lcolor(black) lwidth(thin)) yline(0, lcolor(black) lwidth(thin)) ///
>         xlabel(-5(1)`hmax', labsize(small)) ylabel(#8, labsize(small) format(%9.3f)) ///
>         xtitle("Years relative to Medicaid expansion", size(small)) ///
>         ytitle("`ytitle'", size(small)) title("`title'", size(medsmall)) ///
>         `annot' ///
>         legend(off) graphregion(color(white)) plotregion(color(white))
 22.     graph export "${figdir}/`fname'.png", as(png) replace width(1200) height(800)
 23.     graph export "${latex_figdir}/`fname'.png", as(png) replace width(1200) height(800)
 24.     graph export "${figdir}/`fname'.pdf", replace
 25.     graph export "${latex_figdir}/`fname'.pdf", replace
 26.     restore
 27. end

. 
end of do-file

