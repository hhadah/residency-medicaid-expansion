. * -------------------------------------------------------------------------
. * _avgatt2: mean of tau0..tau`hmax' from did_imputation on the CURRENT data,
. * for outcome `outcome', cohort variable `cohortvar', extra options `extra'
. * (e.g. autosample). Mirrors each reported spec's estimator options exactly.
. * -------------------------------------------------------------------------
. capture program drop _avgatt2

. program define _avgatt2, rclass
  1.     args cohortvar outcome hmax extra
  2.     capture noisily did_imputation `outcome' program_numeric_id year `cohortvar' ///
>         [aw=total_population_10], horizons(0/`hmax') pretrend(5) ///
>         fe(program_numeric_id year) cluster(state_id) minn(0) `extra'
  3.     if (_rc != 0) {
  4.         return scalar att = .
  5.         exit
  6.     }
  7.     local s = 0
  8.     local n = 0
  9.     forval h = 0/`hmax' {
 10.         capture scalar __b = _b[tau`h']
 11.         if (_rc == 0) {
 12.             local s = `s' + __b
 13.             local n = `n' + 1
 14.         }
 15.     }
 16.     return scalar att = cond(`n' > 0, `s'/`n', .)
 17. end

. 
. * -------------------------------------------------------------------------
. * Results collector
. * -------------------------------------------------------------------------
. tempname ri

. tempfile ri_file

. postfile `ri' str24 spec double obs_att ri_p reps valid n_states n_treated_states ///
>     using "`ri_file'", replace
(file /var/folders/yk/l30p1rcd2fsfx74wfvs62cmh0000gn/T//S_88759.000003 not found)

. 
. * -------------------------------------------------------------------------
. * _rispec2: restricts `master' to the condition in global RI_SAMPLEIF, computes
. * the observed ATT, then REPS permutations of the state-level cohort vector
. * under the sharp null (cohorts paired with the sample's ACTUAL state_ids in
. * random order), and the two-sided RI p-value. Results -> globals.
. * -------------------------------------------------------------------------
. capture program drop _rispec2

. program define _rispec2
  1.     args specname master reps outcome hmax extra
  2.     use "`master'", clear
  3.     keep if $RI_SAMPLEIF
  4. 
.     * ---- observed statistic ----
.     _avgatt2 year_expanded `outcome' `hmax' "`extra'"
  5.     local obs = r(att)
  6. 
.     * ---- state-level cohort pool (one row per state), stored once ----
.     preserve
  7.         bysort state_id: keep if _n == 1
  8.         keep state_id year_expanded
  9.         count
 10.         local Ns = r(N)
 11.         count if !missing(year_expanded)
 12.         local Ntr = r(N)
 13.         tempfile states0
 14.         save `states0'
 15.     restore
 16. 
.     * ---- permutation loop ----
.     local ge = 0
 17.     local valid = 0
 18.     forval r = 1/`reps' {
 19.         preserve
 20.             use `states0', clear
 21.             gen double _rnd = runiform()
 22.             sort _rnd
 23.             gen double ye_perm = year_expanded   // cohorts in random order
 24.             keep ye_perm
 25.             gen long _k = _n
 26.             tempfile cohperm
 27.             save `cohperm'
 28.             use `states0', clear
 29.             keep state_id
 30.             sort state_id
 31.             gen long _k = _n
 32.             merge 1:1 _k using `cohperm', nogen
 33.             keep state_id ye_perm
 34.             tempfile assign
 35.             save `assign'
 36.         restore
 37.         capture drop ye_perm
 38.         merge m:1 state_id using `assign', keep(master match) nogen
 39. 
.         _avgatt2 ye_perm `outcome' `hmax' "`extra'"
 40.         local perm = r(att)
 41.         capture drop ye_perm
 42.         if (`perm' < .) {
 43.             local valid = `valid' + 1
 44.             if (abs(`perm') >= abs(`obs') - 1e-12) local ge = `ge' + 1
 45.         }
 46.     }
 47.     local rip = cond(`valid' > 0, `ge'/`valid', .)
 48.     di as result "RI [`specname']: obs ATT = " %7.4f `obs' ///
>         "  RI p = " %6.4f `rip' "  (valid " `valid' " of `reps'" ///
>         ", states `Ns', treated `Ntr')"
 49.     global RIG_obs   = `obs'
 50.     global RIG_rip   = `rip'
 51.     global RIG_valid = `valid'
 52.     global RIG_Ns    = `Ns'
 53.     global RIG_Ntr   = `Ntr'
 54. end

. 
. * -------------------------------------------------------------------------
. * Run the specs (estimator options mirror the reported spec exactly)
. * -------------------------------------------------------------------------
. global RI_SAMPLEIF "urban_rural == 0"

. _rispec2 "urban" "`master_prog'" `REPS' "matched_per_100k_yr" 5 "autosample"
