>  if rur_post, fcolor("255 127 14%25") lcolor("255 127 
> 14%25") lwidth(none)) ///
>            (line urb_coef urb_period if urb_pre, lcolo
> r("31 119 180") lwidth(medium) lpattern(solid)) ///
>            (line urb_coef urb_period if urb_post, lcol
> or("31 119 180") lwidth(medium) lpattern(solid)) ///
>            (line rur_coef rur_period if rur_pre, lcolo
> r("255 127 14") lwidth(medium) lpattern(dash)) ///
>            (line rur_coef rur_period if rur_post, lcol
> or("255 127 14") lwidth(medium) lpattern(dash)) ///
