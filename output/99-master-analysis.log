.         local pretrend_text = cond(`pretrend_p' < ., string(`pretrend_p',
>  "%9.2f"), "NA")
139.         local main_text `"text(`y_annot' `x_annot' `"Baseline Mean: `b
> aseline_text'"' `"Post avg = `avg_text' (`pct_text'%)"' `"Treatment p = `
> treat_text'"' `"Pre-trend p = `pretrend_text'"', size(medsmall))"'
