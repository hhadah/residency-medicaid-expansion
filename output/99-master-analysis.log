 opened on:  27 Jan 2026, 19:44:20

. 
. cap mkdir "${figdir}"

. cap mkdir "${tabdir}"

. cap mkdir "${latex_figdir}"

. 
. * ------------------------------------------------------
> -------------------
. * Load cleaned data (produced by 02-data-cleaning.R)
. * ------------------------------------------------------
> -------------------
. use "${datadir}/cleaned_program_residency_medicaid.dta",
>  clear

. 
. *=======================================================
> ========================
. * Data Setup
. *=======================================================
> ========================
. 
. * Panel identifiers
. egen program_numeric_id = group(state institution_code)

. encode state, gen(state_id)

. 
. xtset program_numeric_id year

Panel variable: program_numeric_id (strongly balanced)
 Time variable: year, 2010 to 2019
         Delta: 1 unit

. 
. * Create urban/rural group based on rural_urban_2010
. * 0 = Urban (RUCA codes 1, 2, 3), 1 = Rural (RUCA codes 
> > 3)
. gen urban_rural = (rural_urban_2010 > 3) if !missing(rur
> al_urban_2010)
(220 missing values generated)

. label define urban_rural_lab 0 "Urban" 1 "Rural"

. label values urban_rural urban_rural_lab

. 
. * Keep only observations with non-missing group
. keep if !missing(urban_rural)
(220 observations deleted)

. 
. * Display basic information
. describe rural_urban_2010 urban_rural

