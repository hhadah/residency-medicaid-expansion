. * -------------------------------------------------------------------------
. * _avgatt: mean of tau0..tau5 from did_imputation on the CURRENT data, using
. * cohort variable `1' as the event-time (year_expanded) argument. r(att).
. * -------------------------------------------------------------------------
. capture program drop _avgatt

. program define _avgatt, rclass
  1.     args cohortvar
  2.     capture noisily did_imputation matched_per_100k_yr program_numeric_id year `cohortvar' ///
>         [aw=total_population_10], horizons(0/5) pretrend(5) ///
>         fe(program_numeric_id year) cluster(state_id) minn(0)
  3.     if (_rc != 0) {
  4.         return scalar att = .
  5.         exit
  6.     }
  7.     local s = 0
  8.     local n = 0
  9.     forval h = 0/5 {
 10.         capture scalar __b = _b[tau`h']
 11.         if (_rc == 0) {
 12.             local s = `s' + __b
 13.             local n = `n' + 1
 14.         }
 15.     }
 16.     return scalar att = cond(`n' > 0, `s'/`n', .)
 17. end

. 
. * -------------------------------------------------------------------------
. * Results collector
. * -------------------------------------------------------------------------
. tempname ri

. tempfile ri_file

. postfile `ri' str24 spec double obs_att ri_p reps n_states n_treated_states ///
>     using "`ri_file'", replace
(file /var/folders/yk/l30p1rcd2fsfx74wfvs62cmh0000gn/T//S_88759.000004 not found)

. 
. * -------------------------------------------------------------------------
. * _rispec: restricts `master' to the condition in global RI_SAMPLEIF, computes
. * the observed ATT, then REPS permutations of the state-level cohort vector
. * under the sharp null, and the two-sided RI p-value. Results -> globals.
. * -------------------------------------------------------------------------
. capture program drop _rispec

. program define _rispec
  1.     args specname master reps
  2.     use "`master'", clear
  3.     keep if $RI_SAMPLEIF
  4. 
.     * ---- observed statistic ----
.     _avgatt year_expanded
  5.     local obs = r(att)
  6. 
.     * ---- state-level cohort pool (one row per state), stored once ----
.     preserve
  7.         bysort state_id: keep if _n == 1
  8.         keep state_id year_expanded
  9.         count
 10.         local Ns = r(N)
 11.         count if !missing(year_expanded)
 12.         local Ntr = r(N)
 13.         tempfile states0
 14.         save `states0'
 15.     restore
 16. 
.     * ---- permutation loop ----
.     * NOTE (2026-07-24 fix): the cohort vector must be reassigned to the ACTUAL
.     * state_id values present in the (possibly restricted) sample. The previous
.     * version assigned shuffled cohorts to state_id = 1..Ns, which is only
.     * correct for the full sample; in restricted samples state_id has gaps, so
.     * some permuted cohorts landed on nonexistent states and some sample states
.     * silently became never-treated. We now pair the cohort list with the
.     * sample's own state_ids in random order (a uniform permutation).
.     local ge = 0
 17.     local valid = 0
 18.     forval r = 1/`reps' {
 19.         preserve
 20.             use `states0', clear
 21.             gen double _rnd = runiform()
 22.             sort _rnd
 23.             gen double ye_perm = year_expanded   // cohorts in random order
 24.             keep ye_perm
 25.             gen long _k = _n
 26.             tempfile cohperm
 27.             save `cohperm'
 28.             use `states0', clear
 29.             keep state_id
 30.             sort state_id
 31.             gen long _k = _n
 32.             merge 1:1 _k using `cohperm', nogen
 33.             keep state_id ye_perm
 34.             tempfile assign
 35.             save `assign'
 36.         restore
 37.         capture drop ye_perm
 38.         merge m:1 state_id using `assign', keep(master match) nogen
 39. 
.         _avgatt ye_perm
 40.         local perm = r(att)
 41.         capture drop ye_perm
 42.         if (`perm' < .) {
 43.             local valid = `valid' + 1
 44.             if (abs(`perm') >= abs(`obs') - 1e-12) local ge = `ge' + 1
 45.         }
 46.     }
 47.     local rip = cond(`valid' > 0, `ge'/`valid', .)
 48.     di as result "RI [`specname']: obs ATT = " %7.4f `obs' ///
>         "  RI p = " %6.4f `rip' "  (valid " `valid' " of `reps'" ///
>         ", states `Ns', treated `Ntr')"
 49.     global RIG_obs = `obs'
 50.     global RIG_rip = `rip'
 51.     global RIG_Ns  = `Ns'
 52.     global RIG_Ntr = `Ntr'
 53. end

. 
. * -------------------------------------------------------------------------
. * Run the specs
. * -------------------------------------------------------------------------
. global RI_SAMPLEIF "1"

. _rispec "headline_matched100k" "`master'" `REPS'
