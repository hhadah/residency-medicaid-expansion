> urban observations."
 10.         continue
 11.     }
 12.     
.     quietly count if urban_rural == 1 & treated_state 
> == 1 & !missing(`outcome')
 13.     if (r(N) == 0) {
 14.         di as error "Outcome `outcome': no treated 
> rural observations."
 15.         continue
 16.     }
 17.     
.     di ""
 18.     di "===========================================
> =============================="
 19.     di "HETEROGENEITY ANALYSIS: ${label_`outcome'}"
 20.     di "Outcome variable: `outcome'"
