> umeric_id year year_expanded [aw=total_population_10],
>  ///
>         horizons(0/5) pretrend(5) ///
>         cluster(state_id) ///
>         hetby(urban_rural) ///
>         fe(program_numeric_id year) ///
>         minn(0) autosample
 24.     
.     if (_rc != 0) {
 25.         di as error "did_imputation failed for outc
> ome `outcome'. Error code `_rc'."
 26.         continue
 27.     }
 28.     
.     * =====================
.     * Post-treatment averages and p-value tests
.     * =====================
.     * Test pretrend assumption
.     test pre1 pre2 pre3 pre4 pre5
 29.     local pretrend_p = r(p)
 30. 
.     * Calculate average effects for both groups
.     local avg_urban = (_b[tau0_0] + _b[tau1_0] + _b[ta
> u2_0] + _b[tau3_0] + _b[tau4_0] + _b[tau5_0])/6
 31.     local avg_rural = (_b[tau0_1] + _b[tau1_1] + _b
> [tau2_1] + _b[tau3_1] + _b[tau4_1] + _b[tau5_1])/6
 32.     local avg_diff = `avg_rural' - `avg_urban'
 33. 
.     * Test difference in post averages and get p-value
.     testnl ((_b[tau0_1] + _b[tau1_1] + _b[tau2_1] + _b
> [tau3_1] + _b[tau4_1] + _b[tau5_1])/6) - ((_b[tau0_0] 
> + _b[tau1_0] + _b[tau2_0] + _b[tau3_0] + _b[tau4_0] + 
> _b[tau5_0])/6) = 0
 34.     local avg_diff_p = r(p)
 35. 
.     * Joint test of heterogeneity across all periods
.     test (tau0_0 = tau0_1) (tau1_0 = tau1_1) (tau2_0 =
>  tau2_1) (tau3_0 = tau3_1) (tau4_0 = tau4_1) (tau5_0 =
>  tau5_1)
 36.     local joint_het_p = r(p)
 37. 
.     * Test individual group significance (joint test f
> or post-treatment effects)
.     test tau0_0 tau1_0 tau2_0 tau3_0 tau4_0 tau5_0
 38.     local urban_p = r(p)
 39.     test tau0_1 tau1_1 tau2_1 tau3_1 tau4_1 tau5_1
 40.     local rural_p = r(p)
 41. 
.     * Calculate baseline means (pre-treatment observat
> ions in estimation sample)
.     quietly summarize `outcome' if urban_rural == 0 & 
> year < year_expanded & e(sample) [aw=total_population_
> 10]
 42.     local baseline_urban = r(mean)
 43.     if missing(`baseline_urban') | `baseline_urban'
>  == 0 {
 44.         local baseline_urban = 1
 45.     }
 46.     
.     quietly summarize `outcome' if urban_rural == 1 & 
> year < year_expanded & e(sample) [aw=total_population_
> 10]
 47.     local baseline_rural = r(mean)
 48.     if missing(`baseline_rural') | `baseline_rural'
>  == 0 {
 49.         local baseline_rural = 1
 50.     }
 51.     
.     local pct_urban = (`avg_urban' / `baseline_urban')
>  * 100
 52.     local pct_rural = (`avg_rural' / `baseline_rura
> l') * 100
 53.     if `pct_urban' < -100 local pct_urban = -100
 54.     if `pct_rural' < -100 local pct_rural = -100
 55. 
.     * Compute national/total annual impact for each gr
> oup.
.     * matched (raw): avg * N treated programs in subse
> t.
.     * per_100k:      avg * sum(state_pop across treate
> d programs in subset) / 100k.
.     local urban_national = .
 56.     local rural_national = .
 57.     local has_national = 0
 58.     if "`outcome'" == "matched" {
 59.         quietly levelsof program_numeric_id if trea
> ted_state == 1 & urban_rural == 0 & !missing(`outcome'
> ), local(_uprogs)
 60.         local n_uprogs : word count `_uprogs'
 61.         quietly levelsof program_numeric_id if trea
> ted_state == 1 & urban_rural == 1 & !missing(`outcome'
> ), local(_rprogs)
 62.         local n_rprogs : word count `_rprogs'
 63.         local urban_national = `avg_urban' * `n_upr
> ogs'
 64.         local rural_national = `avg_rural' * `n_rpr
> ogs'
 65.         local has_national = 1
 66.     }
 67.     else if strpos("`outcome'", "_per_100k") > 0 {
 68.         preserve
 69.         keep if treated_state == 1 & urban_rural ==
>  0 & !missing(`outcome')
 70.         collapse (mean) total_population_10, by(pro
> gram_numeric_id)
 71.         quietly summarize total_population_10
 72.         local sum_urban_pop = r(sum)
 73.         restore
 74.         preserve
 75.         keep if treated_state == 1 & urban_rural ==
>  1 & !missing(`outcome')
 76.         collapse (mean) total_population_10, by(pro
> gram_numeric_id)
 77.         quietly summarize total_population_10
 78.         local sum_rural_pop = r(sum)
