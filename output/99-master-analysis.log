> c' & !missing(`outcome'), local(active_programs)
 63.         if (_rc == 0) local n_programs : word count `active_programs'
 64.         
.         capture levelsof state_id if specialty_group == `spec' & !missing
> (`outcome'), local(active_states)
 65.         if (_rc == 0) local n_states : word count `active_states'
 66. 
.         * Compute national/total annual impact for annotation, restricted
>  to this specialty group.
.         * matched (raw): avg_treat * N treated programs in this specialty
> .
.         * per_100k:      avg_treat * sum(state_pop across treated program
> s in this specialty) / 100k.
.         local national_effect = .
 67.         local has_national = 0
