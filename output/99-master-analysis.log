. tempname did_results_spec

. tempfile did_results_spec_file

. postfile `did_results_spec' str30 specialty str20 outc
> ome double coef se tstat pvalue avg_treat ///
>     pretrend_p treat_p n_programs n_states using "`did
> _results_spec_file'", replace
(file
    /var/folders/yk/l30p1rcd2fsfx74wfvs62cmh0000gn/T//
    > S_90994.000001 not found)

