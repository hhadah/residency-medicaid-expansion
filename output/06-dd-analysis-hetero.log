. local plotnum = 8

. 
. foreach outcome of global outcomes {
  2.     
.     capture confirm variable `outcome'
  3.     if _rc != 0 {
  4.         di as error "Outcome `outcome' not found. Skipping."
  5.         continue
  6.     }
  7.     
.     quietly count if urban_rural == 0 & treated_state == 1 & !missing(`ou
> tcome')
  8.     if (r(N) == 0) {
  9.         di as error "Outcome `outcome': no treated urban observations.
> "
 10.         continue
 11.     }
 12.     
.     quietly count if urban_rural == 1 & treated_state == 1 & !missing(`ou
> tcome')
 13.     if (r(N) == 0) {
 14.         di as error "Outcome `outcome': no treated rural observations.
> "
 15.         continue
 16.     }
 17.     
.     di ""
 18.     di "==============================================================
> ==========="
 19.     di "HETEROGENEITY ANALYSIS: ${label_`outcome'}"
 20.     di "Outcome variable: `outcome'"
 21.     di "==============================================================
> ==========="
 22.     di ""
 23.     
.     * SPLIT-SAMPLE design: separate did_imputation regressions for urban 
> and
.     * rural programs. Each subsample keeps the never-expansion programs o
> f its
.     * own type as controls, so each group gets its own imputed counterfac
> tual
.     * and its OWN pre-trend test. (Replaces the pooled hetby() interactio
> n,
.     * which shared pre-trends across groups. The formal urban-rural diffe
> rence
.     * test lives in the primary year-varying spec, script 24.)
.     matrix urban = J(11, 5, .)  // 5 pretrends + 6 treatment periods
 24.     matrix rural = J(11, 5, .)
 25.     matrix colnames urban = period coef se ci_upper ci_lower
 26.     matrix colnames rural = period coef se ci_upper ci_lower
 27. 
.     local est_failed = 0
 28.     local has_national = 0
 29.     foreach g in 0 1 {
 30.         local gname = cond(`g'==0, "urban", "rural")
 31.         preserve
 32.         keep if urban_rural == `g'
 33.         quietly count if treated_state == 1 & !missing(`outcome')
 34.         local n_tr = r(N)
 35.         quietly count if treated_state == 0 & !missing(`outcome')
 36.         local n_co = r(N)
 37.         di as text "`gname' subsample (`outcome'): treated obs = `n_tr
> ', control obs = `n_co'"
 38. 
.         capture noisily did_imputation `outcome' program_numeric_id year 
> year_expanded [aw=total_population_10], ///
>             horizons(0/5) pretrend(5) ///
>             cluster(state_id) ///
>             fe(program_numeric_id year) ///
>             minn(0) autosample
 39. 
.         if (_rc != 0) {
 40.             di as error "did_imputation failed for outcome `outcome', 
> group `gname'. Error code `_rc'."
 41.             local est_failed = 1
 42.             restore
 43.             continue
 44.         }
 45. 
.         * Group-specific pre-trend test, average post effect, joint post 
> p
.         local pretrend_`gname' = .
 46.         capture test pre1 pre2 pre3 pre4 pre5
 47.         if _rc == 0 local pretrend_`gname' = r(p)
 48.         local avg_`gname' = (_b[tau0] + _b[tau1] + _b[tau2] + _b[tau3]
>  + _b[tau4] + _b[tau5])/6
 49.         local p_`gname' = .
 50.         capture test tau0 tau1 tau2 tau3 tau4 tau5
 51.         if _rc == 0 local p_`gname' = r(p)
 52. 
.         * Baseline mean (pre-treatment observations in estimation sample)
.         quietly summarize `outcome' if year < year_expanded & e(sample) [
> aw=total_population_10]
 53.         local baseline_`gname' = r(mean)
 54.         if missing(`baseline_`gname'') | `baseline_`gname'' == 0 {
 55.             local baseline_`gname' = 1
 56.         }
 57.         local pct_`gname' = (`avg_`gname'' / `baseline_`gname'') * 100
 58.         if `pct_`gname'' < -100 local pct_`gname' = -100
 59. 
.         * National/total annual impact for this group.
.         * matched (raw): avg * N treated programs in subset.
.         * per_100k:      avg * sum(state_pop across treated programs in s
> ubset) / 100k.
.         local `gname'_national = .
 60.         if "`outcome'" == "matched" {
 61.             quietly levelsof program_numeric_id if treated_state == 1 
> & !missing(`outcome'), local(_progs)
 62.             local n_progs : word count `_progs'
 63.             local `gname'_national = `avg_`gname'' * `n_progs'
 64.             local has_national = 1
 65.         }
 66.         else if strpos("`outcome'", "_per_100k") > 0 {
 67.             tempvar ptag
 68.             quietly egen byte `ptag' = tag(program_numeric_id) if trea
> ted_state == 1 & !missing(`outcome')
 69.             quietly summarize total_population_10 if `ptag' == 1
 70.             local `gname'_national = `avg_`gname'' * r(sum) / 100000
 71.             local has_national = 1
 72.         }
 73. 
.         * Event-study matrix for this group (own pre-trend path)
.         local row = 1
 74.         forval h = 5(-1)1 {
 75.             matrix `gname'[`row',1] = -`h'
 76.             capture matrix `gname'[`row',2] = _b[pre`h']
 77.             capture matrix `gname'[`row',3] = _se[pre`h']
 78.             capture matrix `gname'[`row',4] = _b[pre`h'] + 1.96*_se[pr
> e`h']
 79.             capture matrix `gname'[`row',5] = _b[pre`h'] - 1.96*_se[pr
> e`h']
 80.             local ++row
 81.         }
 82.         forval h = 0/5 {
 83.             matrix `gname'[`row',1] = `h'
 84.             capture matrix `gname'[`row',2] = _b[tau`h']
 85.             capture matrix `gname'[`row',3] = _se[tau`h']
 86.             capture matrix `gname'[`row',4] = _b[tau`h'] + 1.96*_se[ta
> u`h']
 87.             capture matrix `gname'[`row',5] = _b[tau`h'] - 1.96*_se[ta
> u`h']
 88.             local ++row
 89.         }
 90.         restore
 91.     }
 92.     if (`est_failed') {
 93.         di as error "Skipping outcome `outcome': at least one group fa
> iled to estimate."
 94.         continue
 95.     }
 96.     local urban_national_text = cond(`has_national', string(`urban_nat
> ional', "%9.0fc"), "NA")
 97.     local rural_national_text = cond(`has_national', string(`rural_nat
> ional', "%9.0fc"), "NA")
 98. 
.     * Store values in locals for annotation
.     local text_urban = string(`avg_urban', "%9.2f")
 99.     local text_rural = string(`avg_rural', "%9.2f")
100.     local text_urban_p = string(`p_urban', "%9.2f")
101.     local text_rural_p = string(`p_rural', "%9.2f")
102.     local text_urban_pre_p = cond(`pretrend_urban' < ., string(`pretre
> nd_urban', "%9.2f"), "NA")
103.     local text_rural_pre_p = cond(`pretrend_rural' < ., string(`pretre
> nd_rural', "%9.2f"), "NA")
104.     local text_baseline_urban = string(`baseline_urban', "%9.2f")
105.     local text_baseline_rural = string(`baseline_rural', "%9.2f")
106.     local text_pct_urban = string(`pct_urban', "%9.1f")
107.     local text_pct_rural = string(`pct_rural', "%9.1f")
108. 
.     di "Average urban effect: " %9.3f `avg_urban' " (p = " %9.3f `p_urban
> ' ", pre-trend p = " %9.3f `pretrend_urban' ")"
109.     di "Average rural effect: " %9.3f `avg_rural' " (p = " %9.3f `p_ru
> ral' ", pre-trend p = " %9.3f `pretrend_rural' ")"
110.     local avg_diff_ss = `avg_rural' - `avg_urban'
111.     di "Difference (rural - urban, split samples): " %9.3f `avg_diff_s
> s'
112.     if (`has_national') {
113.         di "Avg. annual aggregate effect (urban): " %15.0fc `urban_nat
> ional'
114.         di "Avg. annual aggregate effect (rural): " %15.0fc `rural_nat
> ional'
115.     }
116. 
.     * =====================
.     * Plotting with annotation
.     * =====================
.     * Matrices `urban' and `rural' were filled inside the split-sample lo
> op
.     * (each carries its own pre-trend path).
.     * Convert matrices to variables for plotting
.     preserve
117.     clear
118.     svmat urban, names(urb)
119.     svmat rural, names(rur)
120.     
.     * Rename variables
.     rename urb1 urb_period
121.     rename urb2 urb_coef  
122.     rename urb3 urb_se
123.     rename urb4 urb_ci_upper
124.     rename urb5 urb_ci_lower
125.     
.     rename rur1 rur_period
126.     rename rur2 rur_coef
127.     rename rur3 rur_se  
128.     rename rur4 rur_ci_upper
129.     rename rur5 rur_ci_lower
130.     
.     * Create pre/post indicators for plotting
.     gen urb_pre = (urb_period < 0)
131.     gen urb_post = (urb_period >= 0)
132.     gen rur_pre = (rur_period < 0)  
133.     gen rur_post = (rur_period >= 0)
134. 
.     * Calculate dynamic annotation coordinates using maximum upper confid
> ence intervals from both groups
.     quietly summarize urb_ci_upper
135.     local max1 = r(max)
136.     quietly summarize rur_ci_upper
137.     local max2 = r(max) 
138.     local y_annot = max(`max1', `max2') * 0.9
139.     local x_annot = -2
140.     
.     local short = "${short_`outcome'}"
141.     local label = "${label_`outcome'}"
142.     if ("`label'" == "") {
143.         local label = "`outcome'"
144.     }
145.     local prefix : display %02.0f `plotnum'
146.     local ytitle_str "Treatment Effect (difference-in-differences)"
147.     local plot_title "Heterogeneity: Urban vs Rural - `label'"
148. 
.     * Adjust for per 100k outcomes
.     if (strpos("`short'", "_100k") > 0) {
149.         local ytitle_str "Treatment Effect (per 100,000 population)"
150.         local x_annot = -2
151.     }
152.     if ("`outcome'" == "matched") {
153.         local ytitle_str "Treatment Effect (number of residency positi
> ons)"
154.     }
155. 
.     * Build text annotations.
.     * Main annotation (left): urban/rural averages and difference.
.     * Extra annotation at x = 3, same y-level: national/total impact spli
> t by urban/rural
.     * (residency positions for raw matched; additional doctors nationally
>  for per-100k).
.     local main_text `"text(`y_annot' `x_annot' `"Urban Avg: `text_urban' 
> (p=`text_urban_p', pre p=`text_urban_pre_p')"' `"Rural Avg: `text_rural' 
> (p=`text_rural_p', pre p=`text_rural_pre_p')"', size(medsmall))"'
156.     local extra_text ""
157.     if ("`outcome'" == "matched") {
158.         local extra_text `"text(`y_annot' 3 `"Avg. annual change in"' 
> `"residency positions:"' `"Urban: `urban_national_text'"' `"Rural: `rural
> _national_text'"', size(medium))"'
159.     }
160.     else if (strpos("`short'", "_100k") > 0) {
161.         local extra_text `"text(`y_annot' 3 `"Avg. annual change in"' 
> `"doctors nationally:"' `"Urban: `urban_national_text'"' `"Rural: `rural_
> national_text'"', size(medium))"'
162.     }
163. 
.     * Create combined plot using twoway, with annotation
.     twoway (rarea urb_ci_upper urb_ci_lower urb_period if urb_pre, fcolor
> ("31 119 180%20") lcolor("31 119 180%20") lwidth(none)) ///
>            (rarea urb_ci_upper urb_ci_lower urb_period if urb_post, fcolo
> r("31 119 180%20") lcolor("31 119 180%20") lwidth(none)) ///
>            (rarea rur_ci_upper rur_ci_lower rur_period if rur_pre, fcolor
> ("255 127 14%25") lcolor("255 127 14%25") lwidth(none)) ///
>            (rarea rur_ci_upper rur_ci_lower rur_period if rur_post, fcolo
> r("255 127 14%25") lcolor("255 127 14%25") lwidth(none)) ///
>            (line urb_coef urb_period if urb_pre, lcolor("31 119 180") lwi
> dth(medium) lpattern(solid)) ///
>            (line urb_coef urb_period if urb_post, lcolor("31 119 180") lw
> idth(medium) lpattern(solid)) ///
>            (line rur_coef rur_period if rur_pre, lcolor("255 127 14") lwi
> dth(medium) lpattern(dash)) ///
>            (line rur_coef rur_period if rur_post, lcolor("255 127 14") lw
> idth(medium) lpattern(dash)) ///
>            (scatter urb_coef urb_period if urb_pre, mcolor("31 119 180") 
> msize(medium) msymbol(circle)) ///
>            (scatter urb_coef urb_period if urb_post, mcolor("31 119 180")
>  msize(medium) msymbol(circle)) ///
>            (scatter rur_coef rur_period if rur_pre, mcolor("255 127 14") 
> msize(medium) msymbol(triangle)) ///
>            (scatter rur_coef rur_period if rur_post, mcolor("255 127 14")
>  msize(medium) msymbol(triangle)) ///
>            , ///
>            xline(-0.5, lcolor(black) lpattern(solid) lwidth(thin)) ///
>            yline(0, lcolor(black) lpattern(solid) lwidth(thin)) ///
>            xlabel(-5(1)5, labsize(small)) ///
>            ylabel(#10, labsize(small) format(%9.2f)) ///
>            xtitle("Years relative to Medicaid expansion", size(small)) //
> /
>            ytitle("`ytitle_str'", size(small)) ///
>            legend(order(9 11) label(9 "Urban") label(11 "Rural") ///
>                position(6) rows(1) size(small)) ///
>            `main_text' ///
>            `extra_text' ///
>            graphregion(color(white)) plotregion(color(white))
164.     
.     local outfname = "${fname_`outcome'}"
165.     graph export "${figdir}/`outfname'.png", as(png) replace width(120
