. foreach outcome of global outcomes {
  2.     
.     capture confirm variable `outcome'
  3.     if _rc != 0 {
  4.         di as error "Outcome `outcome' not found. Ski
> pping."
  5.         continue
  6.     }
  7.     
.     quietly count if urban_rural == 0 & treated_state ==
>  1 & !missing(`outcome')
  8.     if (r(N) == 0) {
  9.         di as error "Outcome `outcome': no treated ur
> ban observations."
 10.         continue
 11.     }
 12.     
.     quietly count if urban_rural == 1 & treated_state ==
>  1 & !missing(`outcome')
 13.     if (r(N) == 0) {
 14.         di as error "Outcome `outcome': no treated ru
> ral observations."
 15.         continue
 16.     }
 17.     
.     di ""
 18.     di "=============================================
> ============================"
 19.     di "HETEROGENEITY ANALYSIS: ${label_`outcome'}"
 20.     di "Outcome variable: `outcome'"
 21.     di "=============================================
> ============================"
 22.     di ""
 23.     
.     * Run did_imputation with heterogeneous effects by u
> rban/rural (0 = urban, 1 = rural)
.     capture noisily did_imputation `outcome' program_num
> eric_id year year_expanded [aw=total_population_10], ///
>         horizons(0/5) pretrend(5) ///
>         cluster(state_id) ///
>         hetby(urban_rural) ///
>         fe(program_numeric_id year) ///
>         minn(0) autosample
 24.     
.     if (_rc != 0) {
 25.         di as error "did_imputation failed for outcom
> e `outcome'. Error code `_rc'."
 26.         continue
 27.     }
 28.     
.     * =====================
.     * Post-treatment averages and p-value tests
.     * =====================
.     * Test pretrend assumption
.     test pre1 pre2 pre3 pre4 pre5
 29.     local pretrend_p = r(p)
 30. 
.     * Calculate average effects for both groups
.     local avg_urban = (_b[tau0_0] + _b[tau1_0] + _b[tau2
> _0] + _b[tau3_0] + _b[tau4_0] + _b[tau5_0])/6
 31.     local avg_rural = (_b[tau0_1] + _b[tau1_1] + _b[t
> au2_1] + _b[tau3_1] + _b[tau4_1] + _b[tau5_1])/6
 32.     local avg_diff = `avg_rural' - `avg_urban'
 33. 
.     * Test difference in post averages and get p-value
.     testnl ((_b[tau0_1] + _b[tau1_1] + _b[tau2_1] + _b[t
> au3_1] + _b[tau4_1] + _b[tau5_1])/6) - ((_b[tau0_0] + _b
> [tau1_0] + _b[tau2_0] + _b[tau3_0] + _b[tau4_0] + _b[tau
> 5_0])/6) = 0
 34.     local avg_diff_p = r(p)
 35. 
.     * Joint test of heterogeneity across all periods
.     test (tau0_0 = tau0_1) (tau1_0 = tau1_1) (tau2_0 = t
> au2_1) (tau3_0 = tau3_1) (tau4_0 = tau4_1) (tau5_0 = tau
> 5_1)
 36.     local joint_het_p = r(p)
 37. 
.     * Test individual group significance (joint test for
>  post-treatment effects)
.     test tau0_0 tau1_0 tau2_0 tau3_0 tau4_0 tau5_0
 38.     local urban_p = r(p)
 39.     test tau0_1 tau1_1 tau2_1 tau3_1 tau4_1 tau5_1
 40.     local rural_p = r(p)
 41. 
.     * Calculate baseline means (pre-treatment observatio
> ns in treated states)
.     quietly summarize `outcome' if urban_rural == 0 & tr
> eated_state == 1 & year < year_expanded [aw=total_popula
> tion_10]
 42.     local baseline_urban = r(mean)
 43.     if missing(`baseline_urban') | `baseline_urban' =
> = 0 {
 44.         local baseline_urban = 1
 45.     }
 46.     
.     quietly summarize `outcome' if urban_rural == 1 & tr
> eated_state == 1 & year < year_expanded [aw=total_popula
> tion_10]
 47.     local baseline_rural = r(mean)
 48.     if missing(`baseline_rural') | `baseline_rural' =
> = 0 {
 49.         local baseline_rural = 1
 50.     }
 51.     
.     local pct_urban = (`avg_urban' / `baseline_urban') *
>  100
 52.     local pct_rural = (`avg_rural' / `baseline_rural'
> ) * 100
 53.     if `pct_urban' < -100 local pct_urban = -100
 54.     if `pct_rural' < -100 local pct_rural = -100
 55. 
.     * Store values in locals for annotation
.     local text_urban = string(`avg_urban', "%9.2f")
 56.     local text_rural = string(`avg_rural', "%9.2f")
 57.     local text_urban_p = string(`urban_p', "%9.2f")
 58.     local text_rural_p = string(`rural_p', "%9.2f")
 59.     local text_het = string(`joint_het_p', "%9.2f")
 60.     local text_avg_diff = string(`avg_diff', "%9.2f")
 61.     local text_avg_diff_p = string(`avg_diff_p', "%9.
> 2f")
 62.     local text_baseline_urban = string(`baseline_urba
> n', "%9.2f")
 63.     local text_baseline_rural = string(`baseline_rura
> l', "%9.2f")
 64.     local text_pct_urban = string(`pct_urban', "%9.1f
> ")
 65.     local text_pct_rural = string(`pct_rural', "%9.1f
> ")
 66.     
.     di "Average urban effect: " %9.3f `avg_urban' " (p =
>  " %9.3f `urban_p' ")"
 67.     di "Average rural effect: " %9.3f `avg_rural' " (
> p = " %9.3f `rural_p' ")"
