 71. 
.     * =====================
.     * Plotting with annotation
.     * =====================
.     * Create matrices for both groups (0 = urban, 1 = ru
> ral)
.     matrix urban = J(11, 5, .)  // 5 pretrends + 6 treat
> ment periods
 72.     matrix rural = J(11, 5, .)
 73.     matrix colnames urban = period coef se ci_upper c
> i_lower
 74.     matrix colnames rural = period coef se ci_upper c
> i_lower
 75.     
.     local row = 1
 76.     
.     * Pretrend coefficients (same for both groups)
.     forval h = 5(-1)1 {
 77.         * Urban counties
.         matrix urban[`row',1] = -`h'
 78.         matrix urban[`row',2] = _b[pre`h']
 79.         matrix urban[`row',3] = _se[pre`h']
 80.         matrix urban[`row',4] = _b[pre`h'] + 1.96*_se
> [pre`h']
 81.         matrix urban[`row',5] = _b[pre`h'] - 1.96*_se
> [pre`h']
 82.         
.         * Rural counties (same pretrends)
.         matrix rural[`row',1] = -`h'
 83.         matrix rural[`row',2] = _b[pre`h']
 84.         matrix rural[`row',3] = _se[pre`h']  
 85.         matrix rural[`row',4] = _b[pre`h'] + 1.96*_se
> [pre`h']
 86.         matrix rural[`row',5] = _b[pre`h'] - 1.96*_se
> [pre`h']
 87.         
.         local ++row
 88.     }
 89.     
.     * Treatment coefficients - separate by group
.     forval h = 0/5 {
 90.         * Urban (tau_0)
.         matrix urban[`row',1] = `h'
