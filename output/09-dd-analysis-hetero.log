 23.     
.     * Run did_imputation with heterogeneous effe
> cts by urban/rural (0 = urban, 1 = rural)
.     capture noisily did_imputation `outcome' pro
> gram_numeric_id year year_expanded [aw=total_pop
> ulation_10], ///
>         horizons(0/5) pretrend(5) ///
>         cluster(state_id) ///
>         hetby(urban_rural) ///
>         fe(program_numeric_id year) ///
>         minn(0) autosample
 24.     
.     if (_rc != 0) {
 25.         di as error "did_imputation failed fo
> r outcome `outcome'. Error code `_rc'."
 26.         continue
 27.     }
 28.     
.     * =====================
.     * Post-treatment averages and p-value tests
.     * =====================
.     * Test pretrend assumption
.     test pre1 pre2 pre3 pre4 pre5
 29.     local pretrend_p = r(p)
 30. 
.     * Calculate average effects for both groups
.     local avg_urban = (_b[tau0_0] + _b[tau1_0] +
>  _b[tau2_0] + _b[tau3_0] + _b[tau4_0] + _b[tau5_
> 0])/6
 31.     local avg_rural = (_b[tau0_1] + _b[tau1_1
> ] + _b[tau2_1] + _b[tau3_1] + _b[tau4_1] + _b[ta
> u5_1])/6
 32.     local avg_diff = `avg_rural' - `avg_urban
> '
 33. 
.     * Test difference in post averages and get p
> -value
.     testnl ((_b[tau0_1] + _b[tau1_1] + _b[tau2_1
> ] + _b[tau3_1] + _b[tau4_1] + _b[tau5_1])/6) - (
> (_b[tau0_0] + _b[tau1_0] + _b[tau2_0] + _b[tau3_
> 0] + _b[tau4_0] + _b[tau5_0])/6) = 0
 34.     local avg_diff_p = r(p)
 35. 
.     * Joint test of heterogeneity across all per
> iods
.     test (tau0_0 = tau0_1) (tau1_0 = tau1_1) (ta
> u2_0 = tau2_1) (tau3_0 = tau3_1) (tau4_0 = tau4_
> 1) (tau5_0 = tau5_1)
 36.     local joint_het_p = r(p)
 37. 
.     * Test individual group significance (joint 
> test for post-treatment effects)
.     test tau0_0 tau1_0 tau2_0 tau3_0 tau4_0 tau5
> _0
 38.     local urban_p = r(p)
 39.     test tau0_1 tau1_1 tau2_1 tau3_1 tau4_1 t
> au5_1
 40.     local rural_p = r(p)
 41. 
.     * Calculate baseline means (pre-treatment ob
> servations in estimation sample)
.     quietly summarize `outcome' if urban_rural =
> = 0 & year < year_expanded & e(sample) [aw=total
> _population_10]
 42.     local baseline_urban = r(mean)
 43.     if missing(`baseline_urban') | `baseline_
> urban' == 0 {
 44.         local baseline_urban = 1
 45.     }
 46.     
.     quietly summarize `outcome' if urban_rural =
> = 1 & year < year_expanded & e(sample) [aw=total
> _population_10]
 47.     local baseline_rural = r(mean)
 48.     if missing(`baseline_rural') | `baseline_
> rural' == 0 {
 49.         local baseline_rural = 1
 50.     }
 51.     
.     local pct_urban = (`avg_urban' / `baseline_u
> rban') * 100
 52.     local pct_rural = (`avg_rural' / `baselin
> e_rural') * 100
 53.     if `pct_urban' < -100 local pct_urban = -
> 100
 54.     if `pct_rural' < -100 local pct_rural = -
> 100
 55. 
.     * Store values in locals for annotation
.     local text_urban = string(`avg_urban', "%9.2
> f")
 56.     local text_rural = string(`avg_rural', "%
