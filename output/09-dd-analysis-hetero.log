> 1.96*_se[pre`h']
 81.         matrix urban[`row',5] = _b[pre`h'] - 
> 1.96*_se[pre`h']
 82.         
.         * Rural counties (same pretrends)
.         matrix rural[`row',1] = -`h'
 83.         matrix rural[`row',2] = _b[pre`h']
 84.         matrix rural[`row',3] = _se[pre`h']  
 85.         matrix rural[`row',4] = _b[pre`h'] + 
> 1.96*_se[pre`h']
 86.         matrix rural[`row',5] = _b[pre`h'] - 
> 1.96*_se[pre`h']
 87.         
.         local ++row
 88.     }
 89.     
.     * Treatment coefficients - separate by group
.     forval h = 0/5 {
 90.         * Urban (tau_0)
