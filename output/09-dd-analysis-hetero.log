 98.         matrix rural[`row',4] = _b[tau`h'_1] + 1.96*_
> se[tau`h'_1]
 99.         matrix rural[`row',5] = _b[tau`h'_1] - 1.96*_
> se[tau`h'_1]
100.         
.         local ++row
101.     }
