.     * Create matrices for both groups (0 = urban
> , 1 = rural)
.     matrix urban = J(11, 5, .)  // 5 pretrends +
>  6 treatment periods
 72.     matrix rural = J(11, 5, .)
 73.     matrix colnames urban = period coef se ci
> _upper ci_lower
 74.     matrix colnames rural = period coef se ci
> _upper ci_lower
 75.     
.     local row = 1
 76.     
.     * Pretrend coefficients (same for both group
> s)
.     forval h = 5(-1)1 {
 77.         * Urban counties
.         matrix urban[`row',1] = -`h'
 78.         matrix urban[`row',2] = _b[pre`h']
 79.         matrix urban[`row',3] = _se[pre`h']
