> ================================
. 
. * Use gen_specialty_alt for specialty grouping
. capture confirm variable gen_specialty_alt

. if _rc != 0 {
.     di as error "Variable gen_specialty_alt not 
> found. Check data."
.     exit 459
. }

. 
. * Create urban/rural group based on ruca_1_2010
. * 0 = Urban (RUCA codes 1, 2, 3), 1 = Rural (RUC
> A codes > 3)
. gen urban_rural = (ruca_1_2010 > 3) if !missing(
> ruca_1_2010)
(590 missing values generated)

. label define urban_rural_lab 0 "Urban" 1 "Rural"

. label values urban_rural urban_rural_lab

. 
. * Build specialty_group from gen_specialty_alt
. capture drop specialty_group specialty_group_nam
> e

. encode gen_specialty_alt, gen(specialty_group)

. gen str30 specialty_group_name = gen_specialty_a
> lt

. 
. * Check for unclassified rows
. quietly count if missing(gen_specialty_alt) | ge
> n_specialty_alt == ""

. if r(N) > 0 {
.     di as error "WARNING: " r(N) " rows have mis
> sing gen_specialty_alt - dropping"
.     drop if missing(gen_specialty_alt) | gen_spe
> cialty_alt == ""
. }

. 
. * Keep only observations with non-missing urban_
> rural
. keep if !missing(urban_rural)
(590 observations deleted)

. 
. * ----------------------------------------------
> ---------------------------
. * Recreate treatment flags
. * ----------------------------------------------
> ---------------------------
. capture confirm variable treated_state

. if _rc != 0 {
.     gen byte treated_state = (year_expanded < .)
. }

. 
. capture confirm variable post_expansion

. if _rc != 0 {
.     gen byte post_expansion = ///
>         (treated_state == 1 & year_expanded < . 
> & year >= year_expanded)
. }

. 
. capture confirm variable treated_post

. if _rc != 0 {
.     gen byte treated_post = treated_state * post
> _expansion
. }

. 
. capture confirm variable year_expanded

. if _rc != 0 {
.     di as error "Variable year_expanded not foun
> d. Re-run 02-data-cleaning.R."
.     exit 459
. }

. 
