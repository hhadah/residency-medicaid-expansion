.         * matched (raw): avg_treat * N treated programs in this specialty
> .
.         * per_100k:      avg_treat * sum(state_pop across treated program
> s in this specialty) / 100k.
.         local national_effect = .
 67.         local has_national = 0
 68.         if "`outcome'" == "matched" {
 69.             quietly levelsof program_numeric_id if specialty_group == 
> `spec' & treated_state == 1 & !missing(`outcome'), local(_tprogs)
 70.             local n_tprogs : word count `_tprogs'
 71.             local national_effect = `avg_treat' * `n_tprogs'
 72.             local has_national = 1
 73.         }
 74.         else if strpos("`outcome'", "_per_100k") > 0 {
