. * -------------------------------------------------------------------------
. * Recreate treatment flags
. * -------------------------------------------------------------------------
. capture confirm variable treated_state

. if _rc != 0 {
.     gen byte treated_state = (year_expanded < .)
. }

. 
. capture confirm variable post_expansion

. if _rc != 0 {
.     gen byte post_expansion = ///
>         (treated_state == 1 & year_expanded < . & year >= year_expanded)
. }

. 
. capture confirm variable treated_post

. if _rc != 0 {
.     gen byte treated_post = treated_state * post_expansion
. }

. 
. capture confirm variable year_expanded

. if _rc != 0 {
.     di as error "Variable year_expanded not found. Re-run 02-data-cleaning.R."
.     exit 459
. }

. 
. * -------------------------------------------------------------------------
. * Panel identifiers
. * -------------------------------------------------------------------------
. egen program_numeric_id = group(state institution_code)

. encode state, gen(state_id)

. 
. * -------------------------------------------------------------------------
. * Outcomes and labels
. * -------------------------------------------------------------------------
. global outcomes "matched_per_100k quota_per_100k"

. global label_quota_per_100k "Residency Quota Positions per 100k Population"

. global label_matched_per_100k "Matched Residency Positions per 100k Population"

. 
. global short_quota_per_100k "quota_per_100k"

. global short_matched_per_100k "matched_per_100k"

. 
. * -------------------------------------------------------------------------
. * Store DID estimates by specialty
. * -------------------------------------------------------------------------
. tempname did_results_spec

. tempfile did_results_spec_file

. postfile `did_results_spec' str30 specialty str12 outcome double coef se tstat pvalue avg_treat ///
>     pretrend_p treat_p n_programs n_states using "`did_results_spec_file'", replace
(file /var/folders/yk/l30p1rcd2fsfx74wfvs62cmh0000gn/T//S_05029.000001 not found)

. 
. local plotnum = 9

. 
. * Loop over each specialty group
. levelsof specialty_group, local(spec_groups)
1 2

. foreach spec of local spec_groups {
  2.     * Get the specialty group name for this group
.     levelsof specialty_group_name if specialty_group == `spec', local(spec_name) clean
  3.     
.     di ""
  4.     di "========================================================================="
  5.     di "SPECIALTY GROUP: `spec_name'"
  6.     di "========================================================================="
  7.     
.     foreach outcome of global outcomes {
  8.         capture confirm variable `outcome'
  9.         if _rc != 0 {
 10.             di as error "Outcome `outcome' not found. Skipping."
 11.             continue
 12.         }
 13.         
.         quietly count if specialty_group == `spec' & treated_state == 1 & !missing(`outcome')
 14.         if (r(N) == 0) {
 15.             di as error "  `outcome': no treated observations for `spec_name'."
 16.             continue
 17.         }
 18.         
.         quietly count if specialty_group == `spec' & treated_state == 0 & !missing(`outcome')
 19.         if (r(N) == 0) {
 20.             di as error "  `outcome': no control observations for `spec_name'."
 21.             continue
 22.         }
 23.         
.         di ""
 24.         di "--- Outcome: `outcome' ---"
 25.         
.         capture noisily did_imputation `outcome' program_numeric_id year year_expanded ///
>             [aw=total_population_10] if specialty_group == `spec', ///
>             horizons(0/5) pretrend(5) fe(program_numeric_id year) ///
>             cluster(state_id) minn(0)
 26.         
.         if (_rc != 0) {
 27.             di as error "did_imputation failed. Error code `_rc'."
 28.             continue
 29.         }
 30.         
.         local coef = _b[tau0]
 31.         local se   = _se[tau0]
 32.         local tstat = `coef' / `se'
 33.         local pvalue = 2*ttail(e(df_r), abs(`tstat'))
 34.         
.         local tau_sum = 0
 35.         local tau_n = 0
 36.         forval h = 0/5 {
 37.             capture scalar __tmp = _b[tau`h']
 38.             if (_rc == 0) {
 39.                 local tau_sum = `tau_sum' + __tmp
 40.                 local tau_n = `tau_n' + 1
 41.             }
 42.         }
 43.         if (`tau_n' > 0) local avg_treat = `tau_sum' / `tau_n'
 44.         else local avg_treat = .
 45.         
.         local pretrend_p = .
 46.         local treat_p = .
 47.         capture noisily test pre1 pre2 pre3 pre4 pre5
 48.         if (_rc == 0) local pretrend_p = r(p)
 49.         
.         capture noisily test tau0 tau1 tau2 tau3 tau4 tau5
 50.         if (_rc == 0) local treat_p = r(p)
 51.         
.         * Calculate baseline mean (pre-treatment observations for this specialty in treated states)
.         quietly summarize `outcome' if specialty_group == `spec' & treated_state == 1 & year < year_expanded [aw=total_population_10]
 52.         local baseline_mean = r(mean)
 53.         if missing(`baseline_mean') | `baseline_mean' == 0 {
 54.             local baseline_mean = 1
 55.         }
 56.         local pct_effect = (`avg_treat' / `baseline_mean') * 100
 57.         if `pct_effect' < -100 {
 58.             local pct_effect = -100
 59.         }
 60.         
.         local n_programs = .
 61.         local n_states = .
 62.         capture levelsof program_numeric_id if specialty_group == `spec' & !missing(`outcome'), local(active_programs)
 63.         if (_rc == 0) local n_programs : word count `active_programs'
 64.         
.         capture levelsof state_id if specialty_group == `spec' & !missing(`outcome'), local(active_states)
 65.         if (_rc == 0) local n_states : word count `active_states'
 66.         
.         post `did_results_spec' ("`spec_name'") ("`outcome'") ///
>             (`coef') (`se') (`tstat') (`pvalue') (`avg_treat') ///
>             (`pretrend_p') (`treat_p') (`n_programs') (`n_states')
 67.         
.         di "ATT (tau0): " %9.3f `coef' "  SE: " %9.3f `se' "  p = " %9.3f `pvalue'
 68.         di "Average post-treatment effect: " %9.3f `avg_treat'
 69.         
.         * =====================================================================
.         * Event study plot
.         * =====================================================================
.         matrix plot_coef = J(11, 3, .)
 70.         matrix colnames plot_coef = period coef se
 71.         local row = 1
 72.         forval h = 5(-1)1 {
 73.             matrix plot_coef[`row',1] = -`h'
 74.             capture matrix plot_coef[`row',2] = _b[pre`h']
 75.             capture matrix plot_coef[`row',3] = _se[pre`h']
 76.             local ++row
 77.         }
 78.         forval h = 0/5 {
 79.             matrix plot_coef[`row',1] = `h'
 80.             capture matrix plot_coef[`row',2] = _b[tau`h']
 81.             capture matrix plot_coef[`row',3] = _se[tau`h']
 82.             local ++row
 83.         }
 84.         preserve
 85.         clear
 86.         svmat plot_coef, names(col)
 87.         keep if !missing(period)
 88.         gen ci_upper = coef + 1.96*se
 89.         gen ci_lower = coef - 1.96*se
 90.         gen byte pre_period = (period < 0)
 91.         gen byte post_period = (period >= 0)
 92.         local avg_text = cond(`avg_treat' < ., string(`avg_treat', "%9.2f"), "NA")
 93.         local treat_text = cond(`treat_p' < ., string(`treat_p', "%9.2f"), "NA")
 94.         local baseline_text = string(`baseline_mean', "%9.2f")
 95.         local pct_text = string(`pct_effect', "%9.1f")
 96.         local post_line ""
 97.         if (`avg_treat' < .) {
 98.             local post_line "(scatteri `avg_treat' 0 `avg_treat' 5, recast(line) lpattern(dash) lcolor(red) lwidth(medium))"
 99.         }
100.         local short = "${short_`outcome'}"
101.         local label = "${label_`outcome'}"
102.         if ("`label'" == "") {
103.             local label = "`outcome'"
104.         }
105.         local prefix : display %02.0f `plotnum'
106.         local ytitle_str "Treatment Effect (difference-in-differences)"
107.         local plot_title "Event Study: `spec_name' - `label'"
108.         * Calculate annotation position dynamically
.         quietly summarize ci_upper
109.         local y_annot = r(max) * 0.9
110.         local x_annot = -2
111.         * Adjust for per 100k outcomes
.         if (strpos("`short'", "_100k") > 0) {
112.             local ytitle_str "Treatment Effect (per 100,000 population)"
113.             local x_annot = -2
114.         }
115.         twoway ///
>             (rarea ci_upper ci_lower period if pre_period, fcolor(dkgreen%45) lcolor(dkgreen%45) lwidth(none)) ///
>             (rarea ci_upper ci_lower period if post_period, fcolor(maroon%45) lcolor(maroon%45) lwidth(none)) ///
>             (line coef period if pre_period, lcolor(dkgreen) lwidth(medium)) ///
>             (line coef period if post_period, lcolor(maroon) lwidth(medium)) ///
>             (scatter coef period if pre_period, mcolor(dkgreen) msymbol(circle) msize(medlarge)) ///
>             (scatter coef period if post_period, mcolor(maroon) msymbol(circle) msize(medlarge)) ///
>             `post_line' ///
>             , ///
>             xline(-0.5, lcolor(black) lpattern(solid) lwidth(thin)) ///
>             yline(0, lcolor(black) lpattern(solid) lwidth(thin)) ///
>             xlabel(-5(1)5, labsize(small)) ///
>             ylabel(#10, labsize(small) format(%9.3f)) ///
>             xtitle("Years relative to Medicaid expansion", size(small)) ///
>             ytitle("`ytitle_str'", size(small)) ///
>             text(`y_annot' `x_annot' `"Baseline Mean: `baseline_text'"' `"Post avg = `avg_text' (`pct_text'%)"' `"p-value = `treat_text'"', size(large)) ///
>             legend(off) ///
>             graphregion(color(white)) plotregion(color(white))
116.         
.         * Clean specialty name for filename
.         local spec_clean = subinstr("`spec_name'", " ", "_", .)
117.         local spec_clean = subinstr("`spec_clean'", "/", "_", .)
118.         
.         graph export "${figdir}/`prefix'-did_`short'_`spec_clean'_event.png", as(png) replace width(1200) height(800)
119.         graph export "${latex_figdir}/`prefix'-did_`short'_`spec_clean'_event.png", as(png) replace width(1200) height(800)
120.         restore
121.         local ++plotnum
122.     }
123. }
