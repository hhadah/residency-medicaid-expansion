. * -------------------------------------------------------------------------
. * Load cleaned data
. * -------------------------------------------------------------------------
. use "${datadir}/cleaned_residency_medicaid.dta", clear

. 
. * -------------------------------------------------------------------------
. * Use gen_specialty_alt for specialty grouping
. * -------------------------------------------------------------------------
. capture confirm variable gen_specialty_alt

. if _rc != 0 {
.     di as error "Variable gen_specialty_alt not found. Check data."
.     exit 459
. }

