. * ----------------------------------------------------
> ---------------------
. * Store DID estimates
. * ----------------------------------------------------
> ---------------------
. tempname did_results

. tempfile did_results_file

. postfile `did_results' str20 outcome double coef se ts
> tat pvalue avg_treat ///
>     pretrend_p treat_p n_programs n_states using "`did
> _results_file'", replace
