. * -----------------------------------------------------------------------
> --
. * Store DID estimates
. * -----------------------------------------------------------------------
> --
. tempname did_results

. tempfile did_results_file

. postfile `did_results' str20 outcome double coef se tstat pvalue avg_trea
> t ///
>     pretrend_p treat_p n_programs n_states using "`did_results_file'", re
> place
