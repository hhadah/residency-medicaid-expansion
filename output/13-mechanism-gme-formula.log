 63.             matrix plot_coef[`row',1] = -`h'
 64.             capture matrix plot_coef[`row',2] = _b[
> pre`h']
 65.             capture matrix plot_coef[`row',3] = _se
> [pre`h']
 66.             local ++row
 67.         }
