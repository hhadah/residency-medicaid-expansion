. 
. * -------------------------------------------------------------------------
. * Load merged GME funding + expansion-status panel
. * -------------------------------------------------------------------------
. use "${datadir}/gme_funding_expansion.dta", clear

. 
. * Drop territories with no expansion classification (e.g. Puerto Rico):
. * they are neither treated nor a valid comparison unit.
. drop if missing(expansion_state)
(285 observations deleted)

. 
. * -------------------------------------------------------------------------
. * Collapse to one observation per hospital-year
. * -------------------------------------------------------------------------
. * A hospital can file several cost-report segments within a fiscal year
. * (distinct begin/end dates). For an annual panel we sum the dollar payments
. * and resident FTEs received that year, and average the rate/stock measures
. * (per-resident amounts, resident caps, beds). This removes the "repeated
. * time values" that would otherwise break xtset.
. egen provider_numeric_id = group(state provider_ccn)

. 
. collapse (sum)  dgme_payment ime_payment total_gme_payment ///
>                 primary_care_fte non_primary_care_fte dgme_ftes ime_ftes ///
>         (mean) primary_care_pra non_primary_care_pra ///
>                 dgme_resident_cap ime_resident_cap num_beds ///
>         (first) state year_expanded expanded_ever, ///
>         by(provider_numeric_id fiscal_year)

. 
. * -------------------------------------------------------------------------
. * Panel identifiers
. * -------------------------------------------------------------------------
. encode state, gen(state_id)

. 
. * Ever-expansion indicator used to define the treated group in the plots
. gen byte treated_state = expanded_ever

. 
. xtset provider_numeric_id fiscal_year

Panel variable: provider_numeric_id (unbalanced)
 Time variable: fiscal_year, 2000 to 2023, but with gaps
         Delta: 1 unit

. 
. * -------------------------------------------------------------------------
. * Outcomes
. * -------------------------------------------------------------------------
. * asinh (inverse hyperbolic sine) tames the extreme right-skew of dollar
. * payments and is defined at zero, so it keeps hospitals with no DGME/IME.
. gen double asinh_total_gme = asinh(total_gme_payment)

. gen double asinh_dgme      = asinh(dgme_payment)

. gen double asinh_ime       = asinh(ime_payment)

. 
. * Total GME in millions of dollars, so the level event study reads on a
. * human-scale axis (0-4) instead of scientific notation (4.00e+06).
. gen double total_gme_mil = total_gme_payment / 1e6

. 
. label var asinh_total_gme "Total GME Payment (asinh $)"

. label var asinh_dgme      "Direct GME (DGME) Payment (asinh $)"

. label var asinh_ime       "Indirect Medical Ed. (IME) Payment (asinh $)"

. label var total_gme_mil   "Total GME Payment ($ millions)"

. 
. global outcomes "asinh_total_gme asinh_dgme asinh_ime total_gme_mil"

. 
. global label_asinh_total_gme "Total GME Payment (asinh dollars)"

. global label_asinh_dgme      "Direct GME (DGME) Payment (asinh dollars)"

. global label_asinh_ime       "Indirect Medical Education (IME) Payment (asinh
>  dollars)"

. global label_total_gme_mil   "Total GME Payment ($ millions)"

. 
. global short_asinh_total_gme "asinh_total_gme"

. global short_asinh_dgme      "asinh_dgme"

. global short_asinh_ime       "asinh_ime"

. global short_total_gme_mil   "total_gme_mil"

. 
. * -------------------------------------------------------------------------
. * Store event-study estimates
. * -------------------------------------------------------------------------
. tempname did_results

. tempfile did_results_file

. postfile `did_results' str20 outcome double coef se tstat pvalue avg_treat //
> /
>     pretrend_p treat_p baseline pct_effect n_hospitals n_states ///
>     using "`did_results_file'", replace
(file /var/folders/yk/l30p1rcd2fsfx74wfvs62cmh0000gn/T//St36374.000001 not
    found)

. 
. local plotnum = 27

. foreach outcome of global outcomes {
  2.     capture confirm variable `outcome'
  3.     if _rc != 0 {
  4.         di as error "Outcome `outcome' not found. Skipping."
  5.         continue
  6.     }
  7.     quietly count if treated_state == 1 & !missing(`outcome')
  8.     if (r(N) == 0) {
  9.         di as error "Outcome `outcome': no treated observations with data.
> "
 10.         continue
 11.     }
 12.     quietly count if treated_state == 0 & !missing(`outcome')
 13.     if (r(N) == 0) {
 14.         di as error "Outcome `outcome': no control observations with data.
> "
 15.         continue
 16.     }
 17. 
.     di ""
 18.     di "==================================================================
> ======="
 19.     di "EVENT STUDY: ${label_`outcome'}"
 20.     di "Outcome variable: `outcome'"
 21.     di "==================================================================
> ======="
 22.     di ""
 23. 
.     * autosample drops the (few) hospital-years whose FE cannot be imputed
.     * -- e.g. hospitals observed in a single period -- rather than erroring.
.     capture noisily did_imputation `outcome' provider_numeric_id fiscal_year 
> year_expanded, ///
>         horizons(0/5) pretrend(5) fe(provider_numeric_id fiscal_year) ///
>         cluster(state_id) minn(0) autosample
 24.     if (_rc != 0) {
 25.         di as error "did_imputation failed for outcome `outcome'. Error co
> de `_rc'."
 26.         continue
 27.     }
 28. 
.     * Impact effect (tau0) and its inference
.     local coef  = _b[tau0]
 29.     local se    = _se[tau0]
 30.     local tstat = `coef' / `se'
 31.     * did_imputation uses large-sample (normal) inference; it does not set
>  e(df_r)
.     local pvalue = 2*(1 - normal(abs(`tstat')))
 32. 
.     * Average post-treatment ATT across horizons 0-5
.     local tau_sum = 0
 33.     local tau_n = 0
 34.     forval h = 0/5 {
 35.         capture scalar __tmp = _b[tau`h']
 36.         if (_rc == 0) {
 37.             local tau_sum = `tau_sum' + __tmp
 38.             local tau_n = `tau_n' + 1
 39.         }
 40.     }
 41.     if (`tau_n' > 0) local avg_treat = `tau_sum' / `tau_n'
 42.     else local avg_treat = .
 43. 
.     * Joint tests: pre-trends and post-treatment effects
.     local pretrend_p = .
 44.     local treat_p = .
 45.     capture noisily test pre1 pre2 pre3 pre4 pre5
 46.     if (_rc == 0) local pretrend_p = r(p)
 47.     capture noisily test tau0 tau1 tau2 tau3 tau4 tau5
 48.     if (_rc == 0) local treat_p = r(p)
 49. 
.     * Baseline mean (pre-treatment observations in treated states)
.     quietly summarize `outcome' if treated_state == 1 & fiscal_year < year_ex
> panded
 50.     local baseline_mean = r(mean)
 51.     local pct_effect = .
 52.     if !missing(`baseline_mean') & `baseline_mean' != 0 {
 53.         local pct_effect = (`avg_treat' / `baseline_mean') * 100
 54.     }
 55. 
.     * Panel counts on the estimation sample
.     local n_hospitals = .
 56.     local n_states = .
 57.     capture levelsof provider_numeric_id if !missing(`outcome'), local(act
> ive_h)
 58.     if (_rc == 0) local n_hospitals : word count `active_h'
 59.     capture levelsof state_id if !missing(`outcome'), local(active_s)
 60.     if (_rc == 0) local n_states : word count `active_s'
 61. 
.     post `did_results' ("`outcome'") ///
>         (`coef') (`se') (`tstat') (`pvalue') (`avg_treat') ///
>         (`pretrend_p') (`treat_p') (`baseline_mean') (`pct_effect') ///
>         (`n_hospitals') (`n_states')
 62. 
.     di "ATT (tau0): " %12.3f `coef' "  SE: " %12.3f `se' "  p = " %6.3f `pval
> ue'
 63.     di "Average post-treatment effect: " %12.3f `avg_treat'
 64.     if (`pretrend_p' < .) di "Pretrend joint p-value: " %6.3f `pretrend_p'
 65.     if (`treat_p' < .)   di "Treatment joint p-value: " %6.3f `treat_p'
 66. 
.     * ---------------------------------------------------------------------
.     * Collect coefficients for the event-study plot (-5 .. +5)
.     * ---------------------------------------------------------------------
.     matrix plot_coef = J(11, 3, .)
 67.     matrix colnames plot_coef = period coef se
 68.     local row = 1
 69.     forval h = 5(-1)1 {
 70.         matrix plot_coef[`row',1] = -`h'
 71.         capture matrix plot_coef[`row',2] = _b[pre`h']
 72.         capture matrix plot_coef[`row',3] = _se[pre`h']
 73.         local ++row
 74.     }
 75.     forval h = 0/5 {
 76.         matrix plot_coef[`row',1] = `h'
 77.         capture matrix plot_coef[`row',2] = _b[tau`h']
 78.         capture matrix plot_coef[`row',3] = _se[tau`h']
 79.         local ++row
 80.     }
 81. 
.     preserve
 82.     clear
 83.     svmat plot_coef, names(col)
 84.     keep if !missing(period)
 85.     gen ci_upper = coef + 1.96*se
 86.     gen ci_lower = coef - 1.96*se
 87.     gen byte pre_period  = (period < 0)
 88.     gen byte post_period = (period >= 0)
 89. 
.     local avg_text   = cond(`avg_treat' < ., string(`avg_treat', "%9.3f"), "N
> A")
 90.     local treat_text = cond(`treat_p' < ., string(`treat_p', "%9.2f"), "NA
> ")
 91.     local base_text  = cond(`baseline_mean' < ., string(`baseline_mean', "
> %9.2f"), "NA")
 92.     local pct_text   = cond(`pct_effect' < ., string(`pct_effect', "%9.1f"
> ), "NA")
 93. 
.     local post_line ""
 94.     if (`avg_treat' < .) {
 95.         local post_line "(scatteri `avg_treat' 0 `avg_treat' 5, recast(lin
> e) lpattern(dash) lcolor(red) lwidth(medium))"
 96.     }
 97. 
.     local short = "${short_`outcome'}"
 98.     local label = "${label_`outcome'}"
 99.     if ("`label'" == "") local label = "`outcome'"
100.     local prefix : display %02.0f `plotnum'
101.     local plot_title "Event Study: `label'"
102. 
.     * Annotation position
.     quietly summarize ci_upper
103.     local y_annot = r(max) * 0.9
104.     local x_annot = -3
105. 
.     local main_text `"text(`y_annot' `x_annot' `"Baseline Mean: `base_text'"'
>  `"Post avg = `avg_text' (`pct_text'%)"' `"Joint p-value = `treat_text'"', si
> ze(medsmall))"'
106. 
.     twoway ///
>         (rarea ci_upper ci_lower period if pre_period,  fcolor(dkgreen%45) lc
> olor(dkgreen%45) lwidth(none)) ///
>         (rarea ci_upper ci_lower period if post_period, fcolor(maroon%45)  lc
> olor(maroon%45)  lwidth(none)) ///
>         (line coef period if pre_period,  lcolor(dkgreen) lwidth(medium)) ///
>         (line coef period if post_period, lcolor(maroon)  lwidth(medium)) ///
>         (scatter coef period if pre_period,  mcolor(dkgreen) msymbol(circle) 
> msize(medlarge)) ///
>         (scatter coef period if post_period, mcolor(maroon)  msymbol(circle) 
> msize(medlarge)) ///
>         `post_line' ///
>         , ///
>         xline(-0.5, lcolor(black) lpattern(solid) lwidth(thin)) ///
>         yline(0, lcolor(black) lpattern(solid) lwidth(thin)) ///
>         xlabel(-5(1)5, labsize(small)) ///
>         ylabel(#8, labsize(small) format(%9.2f)) ///
>         xtitle("Years relative to Medicaid expansion", size(small)) ///
>         ytitle("Treatment Effect: `label'", size(small)) ///
>         title("`plot_title'", size(medsmall)) ///
>         `main_text' ///
>         legend(off) ///
>         graphregion(color(white)) plotregion(color(white))
107. 
.     graph export "${figdir}/`prefix'-did_`short'_event.png", as(png) replace 
> width(1200) height(800)
108.     graph export "${latex_figdir}/`prefix'-did_`short'_event.png", as(png)
>  replace width(1200) height(800)
109.     restore
110.     local ++plotnum
111. }

