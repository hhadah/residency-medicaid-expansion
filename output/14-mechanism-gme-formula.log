> , labsize(small) format(%9.2f)) ///
>         xtitle("Years relative to Medicaid expan
> sion", size(small)) ///
>         ytitle("Treatment Effect (per 100,000 po
> pulation)", size(small)) ///
>         title("`glab'", size(medsmall)) ///
