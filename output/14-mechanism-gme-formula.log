>         "  (" %4.1f `pct' "% of baseline " %5.3f
>  `baseline' "); joint p = " %5.3f `treat_p'
 42. 
.     * ---- Event-study plot (same scheme as 05/1
> 2) --------------------------
.     matrix plot_coef = J(11, 3, .)
 43.     matrix colnames plot_coef = period coef s
> e
 44.     local row = 1
 45.     forval h = 5(-1)1 {
 46.         matrix plot_coef[`row',1] = -`h'
 47.         capture matrix plot_coef[`row',2] = _
> b[pre`h']
 48.         capture matrix plot_coef[`row',3] = _
> se[pre`h']
 49.         local ++row
 50.     }
 51.     forval h = 0/5 {
 52.         matrix plot_coef[`row',1] = `h'
 53.         capture matrix plot_coef[`row',2] = _
> b[tau`h']
 54.         capture matrix plot_coef[`row',3] = _
> se[tau`h']
 55.         local ++row
 56.     }
 57.     drop _all
 58.     svmat plot_coef, names(col)
 59.     keep if !missing(period)
 60.     gen ci_upper = coef + 1.96*se
 61.     gen ci_lower = coef - 1.96*se
 62.     gen byte pre_period  = (period < 0)
 63.     gen byte post_period = (period >= 0)
 64. 
.     local glab = cond("`grp'"=="volume", "Volume
> -Responsive GME States", "Non-Responsive GME Sta
> tes (Fixed/None)")
 65.     local fname = cond("`grp'"=="volume", "Vo
> lumeResponsive", "NonResponsive")
 66.     local prefix : display %02.0f `plotnum'
 67.     local post_line ""
 68.     if (`att_post' < .) local post_line "(sca
> tteri `att_post' 0 `att_post' 5, recast(line) lp
> attern(dash) lcolor(red) lwidth(medium))"
 69. 
.     twoway ///
>         (rarea ci_upper ci_lower period if pre_p
> eriod,  fcolor(dkgreen%45) lcolor(dkgreen%45) lw
> idth(none)) ///
>         (rarea ci_upper ci_lower period if post_
> period, fcolor(maroon%45)  lcolor(maroon%45)  lw
> idth(none)) ///
