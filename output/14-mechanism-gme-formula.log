 29.         }
 30.     }
 31.     local att_post = cond(`tau_n' > 0, `tau_s
> um'/`tau_n', .)
 32.     local treat_p = .
 33.     capture test tau0 tau1 tau2 tau3 tau4 tau
> 5
 34.     if (_rc == 0) local treat_p = r(p)
 35. 
.     quietly summarize matched_per_100k if treate
> d_state == 1 & year < year_expanded [aw=total_po
> pulation_10]
 36.     local baseline = r(mean)
